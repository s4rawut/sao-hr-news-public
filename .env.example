# Copy this file to .env on the server and fill in the values.
# EMDASH_ENCRYPTION_KEY must be the SAME key that came with this database (sent separately,
# not in Git) — without it the site cannot read the settings it stored encrypted.
EMDASH_ENCRYPTION_KEY=

# The public address of the site (needed for admin login, links and security checks)
EMDASH_SITE_URL=https://hr.example.go.th

# Port/host the Node server listens on (behind Nginx/Apache/IIS reverse proxy)
PORT=4321
HOST=127.0.0.1
