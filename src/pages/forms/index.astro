---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { extractPlainText, getEmDashCollection, getEmDashEntry, getTaxonomyTermsWithCacheHint, getTermsForEntries } from "../../lib/cms";
import PortableText from "../../components/cms/PortableText.astro";
import AudienceSwitch from "../../components/AudienceSwitch.astro";
import FormList from "../../components/FormList.astro";
import Icon from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";
import {
	AUDIENCE_TAXONOMY,
	CATEGORY_ICONS,
	FORM_TAXONOMY,
	categoryShownFor,
	selectedAudience,
} from "../../utils/forms";

// Title and intro text come from the "forms" entry in Pages, which also keeps it in the main menu.
const [{ entry: page, cacheHint: pageHint }, termsResult, audienceResult, formsResult] = await Promise.all([
	getEmDashEntry("pages", "forms"),
	getTaxonomyTermsWithCacheHint(FORM_TAXONOMY),
	getTaxonomyTermsWithCacheHint(AUDIENCE_TAXONOMY),
	getEmDashCollection("forms", { orderBy: { published_at: "desc" }, limit: 500 }),
]);
if (Astro.cache?.enabled) {
	if (pageHint) Astro.cache.set(pageHint);
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(audienceResult.cacheHint);
	Astro.cache.set(formsResult.cacheHint);
}
const audiences = audienceResult.data;
const audience = selectedAudience(Astro.url, audiences);

const title = page?.data.title ?? "แบบฟอร์ม";
const categories = termsResult.data;
const intro = page?.data.content;

// Each category is an open/close bar holding its forms for the selected audience.
// A form with no audience ticked is for everyone, so it shows under every audience.
const allForms = formsResult.entries;
const ids = allForms.map((f) => f.data.id);
const [categoryByForm, audienceByForm] = await Promise.all([
	getTermsForEntries("forms", ids, FORM_TAXONOMY),
	getTermsForEntries("forms", ids, AUDIENCE_TAXONOMY),
]);
const sections = categories
	.map((cat) => {
		const forms = allForms
			.filter((f) => (categoryByForm.get(f.data.id) ?? []).some((t) => t.slug === cat.slug))
			.map((form) => ({ form, groups: audienceByForm.get(form.data.id) ?? [] }))
			.filter(({ groups }) => !audience || groups.length === 0 || groups.some((g) => g.slug === audience));
		return { cat, forms };
	})
	.filter(({ cat, forms }) => categoryShownFor(cat.slug, audience, forms.length > 0));
const hasIntro = extractPlainText(intro).trim().length > 0;
---

<Base title={title} content={page ? { collection: "pages", id: page.data.id, slug: "forms" } : undefined}>
	<Breadcrumbs items={[{ label: title }]} />
	<header class="forms-head">
		<h1 class="section-title" {...page?.edit.title}>{title}</h1>
		{hasIntro && <div class="intro" {...page?.edit.content}><PortableText value={intro} /></div>}
	</header>

	<AudienceSwitch audiences={audiences} selected={audience} basePath="/forms" />

	{
		sections.length === 0 ? (
			<div class="card empty">ยังไม่มีหมวดแบบฟอร์ม</div>
		) : (
			<div class="cat-list">
				{sections.map(({ cat, forms }) => (
					<details class="cat" id={`cat-${cat.slug}`}>
						<summary>
							<span class="cat-icon"><Icon name={CATEGORY_ICONS[cat.slug] ?? "file"} size={16} /></span>
							<span class="cat-name">{cat.label}</span>
							{forms.length > 0 && <span class="cat-count">{forms.length}</span>}
							<span class="cat-chevron" aria-hidden="true"><Icon name="chevron-right" size={18} /></span>
						</summary>
						<div class="cat-body">
							{cat.description && <p class="cat-desc">{cat.description}</p>}
							{forms.length === 0 ? (
								<p class="cat-empty">ยังไม่มีแบบฟอร์มในหมวดนี้</p>
							) : (
								<FormList forms={forms} />
							)}
						</div>
					</details>
				))}
			</div>
		)
	}
</Base>

<style>
	.forms-head {
		margin-bottom: 24px;
	}

	.intro {
		color: var(--color-muted);
		max-width: 760px;
	}

	.cat-list {
		display: grid;
		gap: 8px;
	}

	.cat {
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
		overflow: hidden;
		scroll-margin-top: 130px;
		transition: box-shadow 0.2s, border-color 0.2s;
	}

	.cat[open] {
		border-color: rgb(15 111 135 / 35%);
		box-shadow: var(--shadow);
	}

	summary {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 11px 18px;
		cursor: pointer;
		list-style: none;
		color: var(--color-primary-dark);
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover .cat-name {
		color: var(--color-primary);
	}

	.cat-icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: var(--color-primary-soft);
		color: var(--color-primary);
	}

	.cat-name {
		flex: 1;
		min-width: 0;
		font-size: 0.95rem;
		font-weight: 600;
		transition: color 0.15s;
	}

	.cat-count {
		padding: 1px 10px;
		border-radius: 999px;
		background: var(--color-primary-soft);
		color: var(--color-primary);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.cat-chevron {
		display: grid;
		color: var(--color-muted);
		transition: transform 0.2s;
	}

	.cat[open] .cat-chevron {
		transform: rotate(90deg);
	}

	.cat-body {
		border-top: 1px solid var(--color-border);
	}

	.cat-desc,
	.cat-empty {
		margin: 0;
		padding: 20px 32px 0;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.cat-empty {
		padding-bottom: 22px;
		text-align: center;
	}

	.empty {
		padding: 32px;
		text-align: center;
		color: var(--color-muted);
	}

	@media (max-width: 600px) {
		summary {
			padding: 14px 16px;
		}

		.cat-desc,
		.cat-empty {
			padding-left: 18px;
			padding-right: 18px;
		}
	}
</style>

<script>
	// Open the bar linked from elsewhere (#cat-slug).
	const target = location.hash && document.querySelector(decodeURIComponent(location.hash));
	if (target instanceof HTMLDetailsElement) {
		target.open = true;
		target.scrollIntoView({ block: "start" });
	}
</script>
