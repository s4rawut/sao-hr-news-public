---
/**
 * One-time sign-in link. Opening it shows a button; only pressing it uses the link (so chat apps
 * that preview links cannot use it up). After signing in it goes to "next" (default: add a passkey).
 */
import BareLayout from "../../../admin/BareLayout.astro";
import { audit, consumeToken, createSession } from "../../../lib/admin/auth";
import { safeNext } from "../../../admin/flash";
import { isSecure } from "../../../admin/api";

const token = Astro.url.searchParams.get("token") ?? "";
const next = safeNext(Astro.url.searchParams.get("next"), "/admin/account?addPasskey=1");
let error = "";
if (Astro.request.method === "POST") {
	const result = consumeToken(token);
	if ("error" in result) error = result.error;
	else {
		createSession(Astro.cookies, result.user.id, isSecure(Astro.url));
		audit(result.user.id, "auth.login.link", "user", result.user.id);
		return Astro.redirect(next, 303);
	}
}
---

<BareLayout title="เข้าสู่ระบบด้วยลิงก์">
	<h1>เข้าสู่ระบบหลังบ้าน</h1>
	<p class="muted">ลิงก์นี้ใช้ได้ครั้งเดียว กดปุ่มด้านล่างเพื่อเข้าสู่ระบบ</p>
	<form method="post">
		<button class="btn primary" type="submit">เข้าสู่ระบบ</button>
	</form>
	{error && <p class="login-err">{error} — ขอลิงก์ใหม่จากผู้ดูแลระบบ</p>}
</BareLayout>
