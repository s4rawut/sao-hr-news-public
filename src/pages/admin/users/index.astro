---
/**
 * Users and admins: an admin adds a person with email + password and a role, resets a forgotten
 * password, changes roles, disables or deletes accounts. Passwords are stored only as hashes.
 */
import AdminLayout from "../../../admin/AdminLayout.astro";
import AdminIcon from "../../../admin/AdminIcon.astro";
import { all, get, run } from "../../../lib/cms/db";
import { MIN_PASSWORD, ROLE_LABELS, ROLES, audit, createUser, roleName, setPassword } from "../../../lib/admin/auth";
import { setFlash, thaiDateTime } from "../../../admin/flash";

const me = Astro.locals.user!;
if (me.role < ROLES.ADMIN) return Astro.redirect("/admin", 302);

if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	const action = String(form.get("_action"));
	const id = String(form.get("id") ?? "");
	const adminsLeft = () => get<{ n: number }>(`SELECT count(*) n FROM users WHERE role >= 50 AND disabled = 0 AND email <> 'dev@emdash.local'`)!.n;
	try {
		if (action === "add") {
			const pw = String(form.get("password") ?? "");
			if (pw !== String(form.get("confirm") ?? "")) throw new Error("รหัสผ่านสองช่องไม่ตรงกัน");
			const newId = createUser(String(form.get("email") ?? ""), String(form.get("name") ?? ""), Number(form.get("role")), pw);
			audit(me.id, "user.create", "user", newId, { role: Number(form.get("role")) });
			setFlash(Astro.cookies, "ok", `เพิ่มผู้ใช้ ${String(form.get("email")).trim().toLowerCase()} แล้ว — แจ้งอีเมลและรหัสผ่านให้เจ้าตัวทางช่องทางส่วนตัว`);
		} else if (action === "reset") {
			const pw = String(form.get("password") ?? "");
			setPassword(id, pw);
			audit(me.id, "user.password.reset", "user", id);
			setFlash(Astro.cookies, "ok", "ตั้งรหัสผ่านใหม่แล้ว — แจ้งเจ้าตัวทางช่องทางส่วนตัว (เครื่องที่เข้าไว้เดิมจะต้องเข้าสู่ระบบใหม่)");
		} else if (action === "role") {
			const role = Number(form.get("role"));
			if (!ROLE_LABELS[role]) throw new Error("เลือกสิทธิ์");
			const target = get<{ role: number }>(`SELECT role FROM users WHERE id = ?`, id);
			if (target && target.role >= 50 && role < 50 && adminsLeft() <= 1) throw new Error("ต้องมีผู้ดูแลระบบอย่างน้อย 1 คน");
			run(`UPDATE users SET role = ? WHERE id = ?`, role, id);
			audit(me.id, "user.role", "user", id, { role });
			setFlash(Astro.cookies, "ok", "เปลี่ยนสิทธิ์แล้ว");
		} else if (action === "disable" || action === "enable") {
			if (id === me.id) throw new Error("ปิดบัญชีของตัวเองไม่ได้");
			const target = get<{ role: number }>(`SELECT role FROM users WHERE id = ?`, id);
			if (action === "disable" && target && target.role >= 50 && adminsLeft() <= 1) throw new Error("ต้องมีผู้ดูแลระบบอย่างน้อย 1 คน");
			run(`UPDATE users SET disabled = ? WHERE id = ?`, action === "disable" ? 1 : 0, id);
			audit(me.id, `user.${action}`, "user", id);
			setFlash(Astro.cookies, "ok", action === "disable" ? "ปิดการใช้งานแล้ว" : "เปิดการใช้งานแล้ว");
		} else if (action === "delete") {
			if (id === me.id) throw new Error("ลบบัญชีของตัวเองไม่ได้");
			const target = get<{ role: number }>(`SELECT role FROM users WHERE id = ?`, id);
			if (target && target.role >= 50 && adminsLeft() <= 1) throw new Error("ต้องมีผู้ดูแลระบบอย่างน้อย 1 คน");
			run(`DELETE FROM users WHERE id = ?`, id);
			audit(me.id, "user.delete", "user", id);
			setFlash(Astro.cookies, "ok", "ลบผู้ใช้แล้ว");
		}
	} catch (e) {
		setFlash(Astro.cookies, "error", (e as Error).message);
	}
	return Astro.redirect("/admin/users", 303);
}

const users = all<{ id: string; email: string; name: string | null; role: number; disabled: number; updated_at: string; has_pw: number }>(
	`SELECT id, email, name, role, disabled, updated_at, password_hash IS NOT NULL AS has_pw FROM users WHERE email <> 'dev@emdash.local' ORDER BY role DESC, created_at`,
);
const roleOptions = Object.entries(ROLE_LABELS).sort((a, b) => Number(b[0]) - Number(a[0]));
---

<AdminLayout title="ผู้ใช้และผู้ดูแล" active="users" subtitle="เพิ่มผู้ดูแล กำหนดสิทธิ์ ตั้งรหัสผ่านใหม่">
	<form method="post" class="card card-pad" style="margin-bottom: 20px">
		<h2>เพิ่มผู้ดูแล / ผู้ใช้</h2>
		<input type="hidden" name="_action" value="add" />
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px 14px">
			<div class="field" style="margin: 0"><label for="em">อีเมล (ใช้เข้าสู่ระบบ)</label><input id="em" type="email" name="email" required autocomplete="off" /></div>
			<div class="field" style="margin: 0"><label for="nm">ชื่อที่แสดง</label><input id="nm" type="text" name="name" /></div>
			<div class="field" style="margin: 0">
				<label for="rl">สิทธิ์</label>
				<select id="rl" name="role">{roleOptions.map(([v, l]) => <option value={v} selected={v === "50"}>{l}</option>)}</select>
			</div>
			<div class="field" style="margin: 0"><label for="pw">รหัสผ่าน</label><input id="pw" type="password" name="password" required minlength={MIN_PASSWORD} autocomplete="new-password" /></div>
			<div class="field" style="margin: 0"><label for="pc">ยืนยันรหัสผ่าน</label><input id="pc" type="password" name="confirm" required minlength={MIN_PASSWORD} autocomplete="new-password" /></div>
		</div>
		<p class="help" style="margin: 8px 0 12px">รหัสผ่านอย่างน้อย {MIN_PASSWORD} ตัวอักษร ผสมตัวอักษรและตัวเลข เจ้าตัวเปลี่ยนเองได้ภายหลังที่ "บัญชีของฉัน"</p>
		<button class="btn primary" type="submit"><AdminIcon name="plus" size={16} /> เพิ่มผู้ใช้</button>
	</form>

	<div class="card">
		<div class="table-wrap">
			<table class="list">
				<thead><tr><th>ผู้ใช้</th><th>สิทธิ์</th><th>ใช้งานล่าสุด</th><th>ตั้งรหัสผ่านใหม่</th><th></th></tr></thead>
				<tbody>
					{users.map((u) => (
						<tr style={u.disabled ? "opacity: 0.55" : undefined}>
							<td>
								<strong>{u.name || u.email}</strong>
								{u.id === me.id && <span class="badge published" style="margin-left: 6px">คุณ</span>}
								{u.disabled ? <span class="badge draft" style="margin-left: 6px">ปิดใช้งาน</span> : null}
								{!u.has_pw && <span class="badge warn" style="margin-left: 6px">ยังไม่มีรหัสผ่าน</span>}
								<div class="muted small">{u.email}</div>
							</td>
							<td>
								<form method="post">
									<input type="hidden" name="_action" value="role" />
									<input type="hidden" name="id" value={u.id} />
									<select name="role" style="width: auto" onchange="this.form.requestSubmit()">
										{roleOptions.map(([v]) => <option value={v} selected={Number(v) === u.role}>{roleName(Number(v))}</option>)}
									</select>
								</form>
							</td>
							<td class="muted small">{thaiDateTime(u.updated_at)}</td>
							<td>
								<form method="post" style="display: flex; gap: 6px">
									<input type="hidden" name="_action" value="reset" /><input type="hidden" name="id" value={u.id} />
									<input type="password" name="password" placeholder="รหัสผ่านใหม่" minlength={MIN_PASSWORD} required autocomplete="new-password" style="width: 150px" />
									<button class="btn sm" type="submit">ตั้ง</button>
								</form>
							</td>
							<td style="white-space: nowrap; text-align: right">
								{u.id !== me.id && (
									<form method="post" style="display: inline">
										<input type="hidden" name="_action" value={u.disabled ? "enable" : "disable"} /><input type="hidden" name="id" value={u.id} />
										<button class="btn sm" type="submit">{u.disabled ? "เปิดใช้" : "ปิดใช้"}</button>
									</form>
								)}
								{u.id !== me.id && (
									<form method="post" style="display: inline">
										<input type="hidden" name="_action" value="delete" /><input type="hidden" name="id" value={u.id} />
										<button class="btn sm danger" type="submit" data-confirm={`ลบผู้ใช้ ${u.email}?`}><AdminIcon name="trash" size={14} /></button>
									</form>
								)}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
</AdminLayout>
