---
import AdminLayout from "../../admin/AdminLayout.astro";
import { get, run } from "../../lib/cms/db";
import { MIN_PASSWORD, audit, createSession, roleName, setPassword, verifyPassword } from "../../lib/admin/auth";
import { setFlash } from "../../admin/flash";
import { isSecure } from "../../admin/api";

const user = Astro.locals.user!;
if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	const action = String(form.get("_action"));
	try {
		if (action === "name") {
			run(`UPDATE users SET name = ? WHERE id = ?`, String(form.get("name") ?? "").trim() || null, user.id);
			setFlash(Astro.cookies, "ok", "บันทึกชื่อแล้ว");
		} else if (action === "password") {
			const row = get<{ password_hash: string | null }>(`SELECT password_hash FROM users WHERE id = ?`, user.id)!;
			if (row.password_hash && !verifyPassword(String(form.get("current") ?? ""), row.password_hash)) throw new Error("รหัสผ่านปัจจุบันไม่ถูกต้อง");
			const pw = String(form.get("password") ?? "");
			if (pw !== String(form.get("confirm") ?? "")) throw new Error("รหัสผ่านใหม่สองช่องไม่ตรงกัน");
			setPassword(user.id, pw);
			createSession(Astro.cookies, user.id, isSecure(Astro.url)); // keep this browser signed in; others are signed out
			audit(user.id, "auth.password.change", "user", user.id);
			setFlash(Astro.cookies, "ok", "เปลี่ยนรหัสผ่านแล้ว (เครื่องอื่นที่เข้าไว้จะต้องเข้าสู่ระบบใหม่)");
		}
	} catch (e) {
		setFlash(Astro.cookies, "error", (e as Error).message);
	}
	return Astro.redirect("/admin/account", 303);
}
const me = get<{ name: string | null; email: string; password_hash: string | null }>(`SELECT name, email, password_hash FROM users WHERE id = ?`, user.id)!;
---

<AdminLayout title="บัญชีของฉัน" active="account">
	<div class="card card-pad" style="margin-bottom: 20px">
		<h2>ข้อมูลบัญชี</h2>
		<form method="post" style="display: flex; gap: 10px; align-items: end; flex-wrap: wrap">
			<input type="hidden" name="_action" value="name" />
			<div class="field" style="flex: 1; min-width: 240px; margin: 0">
				<label for="nm">ชื่อที่แสดง</label>
				<input id="nm" type="text" name="name" value={me.name ?? ""} />
			</div>
			<button class="btn" type="submit">บันทึก</button>
		</form>
		<p class="muted small" style="margin: 12px 0 0">อีเมล (ใช้เข้าสู่ระบบ): {me.email} · สิทธิ์: {roleName(user.role)}</p>
	</div>
	<form method="post" class="card card-pad" style="max-width: 520px">
		<h2>เปลี่ยนรหัสผ่าน</h2>
		<input type="hidden" name="_action" value="password" />
		<input type="text" name="username" value={me.email} autocomplete="username" hidden />
		{me.password_hash && (
			<div class="field"><label for="cur">รหัสผ่านปัจจุบัน</label><input id="cur" type="password" name="current" required autocomplete="current-password" /></div>
		)}
		<div class="field"><label for="np">รหัสผ่านใหม่</label><input id="np" type="password" name="password" required minlength={MIN_PASSWORD} autocomplete="new-password" /><p class="help">อย่างน้อย {MIN_PASSWORD} ตัวอักษร ผสมตัวอักษรและตัวเลข</p></div>
		<div class="field"><label for="cp">ยืนยันรหัสผ่านใหม่</label><input id="cp" type="password" name="confirm" required minlength={MIN_PASSWORD} autocomplete="new-password" /></div>
		<button class="btn primary" type="submit">เปลี่ยนรหัสผ่าน</button>
	</form>
</AdminLayout>
