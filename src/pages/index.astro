<script>
	// Calendar arrows: switch months in the browser (no reload). ?m=YYYY-MM in the address opens that
	// month (the static preview ignores query strings on the server, so this also reads it here).
	const cal = document.querySelector<HTMLElement>("[data-calendar]");
	if (cal) {
		const months = [...cal.querySelectorAll<HTMLElement>("[data-cal-month]")];
		// the "รายละเอียดกิจกรรม" box next to the news follows the same month
		// clicking a coloured day lists its events in the box under the calendar
		const detail = cal.parentElement!.querySelector<HTMLElement>("[data-cal-detail]");
		const hint = detail?.querySelector<HTMLElement>("[data-cal-hint]");
		const detailTitle = detail?.querySelector<HTMLElement>("[data-cal-detail-title]");
		const evItems = [...(detail?.querySelectorAll<HTMLElement>("[data-ev-start]") ?? [])];
		const thaiMonthNames = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];
		const selectDay = (key: string | null) => {
			cal.querySelectorAll<HTMLElement>(".mc-day[data-cal-day]").forEach((d) => {
				d.classList.toggle("is-selected", d.dataset.calDay === key);
				d.setAttribute("aria-pressed", String(d.dataset.calDay === key));
			});
			const no = key === null ? NaN : Number(key);
			evItems.forEach((li) => (li.hidden = !(Number(li.dataset.evStart) <= no && no <= Number(li.dataset.evEnd))));
			if (hint) hint.hidden = !!key;
			if (detailTitle) {
				detailTitle.hidden = !key;
				if (key) {
					const d = new Date(no * 86_400_000);
					detailTitle.textContent = `กิจกรรมวันที่ ${d.getUTCDate()} ${thaiMonthNames[d.getUTCMonth()]} ${d.getUTCFullYear() + 543}`;
				}
			}
		};
		let current = Math.max(0, months.findIndex((m) => !m.hidden));
		const showMonth = (i: number) => {
			current = Math.min(months.length - 1, Math.max(0, i));
			months.forEach((m, n) => (m.hidden = n !== current));
			// open today's events if today is in this month and has any
			const todayBtn = months[current].querySelector<HTMLElement>(".mc-day.today[data-cal-day]");
			selectDay(todayBtn?.dataset.calDay ?? null);
		};
		showMonth(current);
		const wanted = new URLSearchParams(location.search).get("m");
		const at = wanted ? months.findIndex((m) => m.dataset.calMonth === wanted) : -1;
		if (at >= 0) showMonth(at);
		cal.addEventListener("click", (e) => {
			const btn = (e.target as Element).closest<HTMLButtonElement>("[data-cal-step]");
			if (btn) showMonth(current + Number(btn.dataset.calStep));
			const day = (e.target as Element).closest<HTMLElement>("[data-cal-day]");
			if (day) selectDay(day.classList.contains("is-selected") && day.classList.contains("mc-day") ? null : day.dataset.calDay!);
		});
	}

	// Featured news: numbered pager, auto-advances unless hovered/focused or reduced motion is on.
	const slider = document.querySelector<HTMLElement>("[data-slider]");
	if (slider) {
		const slides = [...slider.querySelectorAll<HTMLElement>("[data-slide]")];
		const metas = [...slider.querySelectorAll<HTMLElement>("[data-slide-meta]")];
		const pager = [...slider.querySelectorAll<HTMLButtonElement>("[data-goto]")];
		let current = 0;
		const go = (i: number) => {
			current = (i + slides.length) % slides.length;
			slides.forEach((el, n) => (el.hidden = n !== current));
			metas.forEach((el, n) => (el.hidden = n !== current));
			pager.forEach((b, n) => {
				b.classList.toggle("is-active", n === current);
				b.setAttribute("aria-current", String(n === current));
			});
		};
		pager.forEach((b) => b.addEventListener("click", () => go(Number(b.dataset.goto))));
		let paused = false;
		slider.addEventListener("mouseenter", () => (paused = true));
		slider.addEventListener("mouseleave", () => (paused = false));
		slider.addEventListener("focusin", () => (paused = true));
		slider.addEventListener("focusout", () => (paused = false));
		if (slides.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
			setInterval(() => {
				if (!paused && !slider.closest<HTMLElement>("[hidden]")) go(current + 1);
			}, 6000);
		}
	}

	// ประกาศ/คำสั่ง/…: category chips (no "ทั้งหมด" – that is the ดูทั้งหมด link). The list is full
	// width, so a page is always "documents_limit" items.
	const section = document.querySelector<HTMLElement>(".docs");
	if (section) {
		const PAGE_ITEMS = Number(section.dataset.limit) || 8;
		const oneColumn = { matches: true, addEventListener: () => {} };
		const buttons = [...section.querySelectorAll<HTMLButtonElement>("[data-filter]")];
		const items = [...section.querySelectorAll<HTMLLIElement>("li[data-cat]")];
		const list = section.querySelector<HTMLElement>("[data-docs-list]")!;
		const empty = section.querySelector<HTMLElement>("[data-empty]");
		const pager = section.querySelector<HTMLElement>("[data-docs-pager]")!;
		const info = section.querySelector<HTMLElement>("[data-pg-info]")!;
		const [prev, next] = [...pager.querySelectorAll<HTMLButtonElement>("[data-pg-step]")];
		const defaultFilter = (buttons.find((b) => b.hasAttribute("data-default")) ?? buttons[0])?.dataset.filter ?? "";
		let filter = defaultFilter;
		// ข้าราชการ / ลูกจ้าง switch beside the heading. The first group (ข้าราชการ) shows posts ticked
		// for it plus posts with no group ticked; any other group (ลูกจ้าง) shows only posts ticked for it.
		const audButtons = [...section.querySelectorAll<HTMLButtonElement>("[data-aud]")].filter((b) => b.tagName === "BUTTON");
		const firstAud = audButtons[0]?.dataset.aud ?? "";
		let aud = firstAud;
		const forAud = (li: HTMLElement, slug = aud) => {
			const groups = (li.dataset.aud ?? "").split(" ").filter(Boolean);
			return !slug || groups.includes(slug) || (slug === firstAud && groups.length === 0);
		};
		let pages: HTMLLIElement[][] = [];
		let page = 0;

		const showPage = (n: number) => {
			page = Math.min(Math.max(0, n), Math.max(0, pages.length - 1));
			items.forEach((li) => {
				li.hidden = true;
				li.classList.remove("pg-first");
			});
			(pages[page] ?? []).forEach((li, i) => {
				li.hidden = false;
				li.classList.toggle("pg-first", i === 0);
			});
			pager.hidden = pages.length <= 1;
			info.textContent = `หน้า ${page + 1} / ${pages.length}`;
			prev.disabled = page === 0;
			next.disabled = page >= pages.length - 1;
		};

		const layout = (keepPage = false) => {
			const matched = items.filter((li) => li.dataset.cat === filter && forAud(li));
			if (empty) empty.hidden = matched.length > 0;
			pages = [];
			if (oneColumn.matches) {
				for (let i = 0; i < matched.length; i += PAGE_ITEMS) pages.push(matched.slice(i, i + PAGE_ITEMS));
			} else {
				// measure every matching item, then fill each page up to the list's height
				pager.hidden = false;
				items.forEach((li) => {
					li.hidden = !matched.includes(li);
					li.classList.remove("pg-first");
				});
				const cs = getComputedStyle(list);
				const room = list.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
				let cur: HTMLLIElement[] = [];
				let used = 0;
				for (const li of matched) {
					const h = li.offsetHeight;
					if (cur.length && used + h > room) {
						pages.push(cur);
						cur = [];
						used = 0;
					}
					cur.push(li);
					used += h;
				}
				if (cur.length) pages.push(cur);
			}
			showPage(keepPage ? page : 0);
		};

		const selectChip = (slug: string) => {
			filter = slug;
			buttons.forEach((x) => {
				x.classList.toggle("is-active", x.dataset.filter === slug);
				x.setAttribute("aria-selected", String(x.dataset.filter === slug));
			});
		};
		// chips with nothing for the chosen group are dimmed (still clickable)
		const markChips = () =>
			buttons.forEach((x) => x.classList.toggle("is-empty", !items.some((li) => li.dataset.cat === x.dataset.filter && forAud(li))));
		buttons.forEach((b) =>
			b.addEventListener("click", () => {
				selectChip(b.dataset.filter ?? "");
				layout();
			}),
		);
		// New-item bubble on a group button: counts the "ใหม่" posts ticked for that group that this
		// browser has not opened the group for yet. Opening the group clears it (remembered per browser).
		const seenKey = (slug: string) => `hr-docs-seen-${slug}`;
		const readSeen = (slug: string): string[] => {
			try {
				return JSON.parse(localStorage.getItem(seenKey(slug)) || "[]");
			} catch {
				return [];
			}
		};
		const newFor = (slug: string) =>
			items.filter((li) => li.hasAttribute("data-new") && (li.dataset.aud ?? "").split(" ").includes(slug)).map((li) => li.dataset.id!);
		const markSeen = (slug: string) => {
			try {
				localStorage.setItem(seenKey(slug), JSON.stringify(newFor(slug)));
			} catch {
				// private mode: the bubble just comes back next visit
			}
		};
		const updateBadges = () =>
			audButtons.forEach((b) => {
				const slug = b.dataset.aud ?? "";
				const badge = b.querySelector<HTMLElement>("[data-aud-badge]");
				if (!badge) return;
				const seen = readSeen(slug);
				const unseen = slug === aud ? 0 : newFor(slug).filter((id) => !seen.includes(id)).length;
				badge.hidden = unseen === 0;
				badge.textContent = String(unseen);
				b.title = unseen ? `มีเรื่องใหม่ ${unseen} เรื่อง` : "";
			});
		if (aud) markSeen(aud);
		updateBadges();
		audButtons.forEach((b) =>
			b.addEventListener("click", () => {
				aud = b.dataset.aud ?? "";
				markSeen(aud);
				audButtons.forEach((x) => {
					x.classList.toggle("is-active", x === b);
					x.setAttribute("aria-pressed", String(x === b));
				});
				// back to ข้าราชการ: the usual chip (คำสั่ง). Another group with nothing in the open chip:
				// jump to the chip of its newest post (e.g. ลูกจ้าง → ระเบียบ)
				if (aud === firstAud) selectChip(defaultFilter);
				else if (!items.some((li) => li.dataset.cat === filter && forAud(li))) {
					const first = items.find((li) => li.dataset.cat && forAud(li));
					if (first) selectChip(first.dataset.cat!);
				}
				markChips();
				updateBadges();
				layout();
			}),
		);
		prev.addEventListener("click", () => showPage(page - 1));
		next.addEventListener("click", () => showPage(page + 1));
		markChips();
		layout();
		// the news column settles once images load / the window changes size
		let t = 0;
		const relayout = () => {
			clearTimeout(t);
			t = window.setTimeout(() => layout(true), 120);
		};
		addEventListener("resize", relayout);
		addEventListener("load", relayout);
		new ResizeObserver(relayout).observe(list);
	}
</script>

