	}

	.perf-list strong {
		font-size: 0.88rem;
		line-height: 1.4;
	}

	@media (max-width: 860px) {
		.perf {
			grid-template-columns: 1fr;
		}
	}

	.see-all {
		margin-left: auto;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--color-muted);
	}

	.see-all:hover {
		color: var(--color-primary);
	}

	/* News tab: featured slider + card grid */
	.news-top {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: 24px;
		align-items: stretch;
	}

	.news-top.no-grid {
		grid-template-columns: minmax(0, 1fr);
	}

	.news-img {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 12px;
		background: var(--color-primary-soft);
	}

	.news-img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.news-ph {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: rgb(255 255 255 / 85%);
		background:
			radial-gradient(circle at 20% 15%, rgb(79 209 165 / 45%), transparent 45%),
			radial-gradient(circle at 85% 90%, rgb(255 255 255 / 12%), transparent 40%),
			linear-gradient(135deg, var(--color-primary), #0f2e3d);
	}

	.news-feature {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		padding: 0;
	}

	.feature-slide {
		display: flex;
		flex-direction: column;
		flex: 1;
		color: inherit;
		text-decoration: none;
	}

	.feature-slide[hidden] {
		display: none;
	}

	.feature-slide:not([hidden]) {
		animation: news-fade 0.45s ease;
	}

	@keyframes news-fade {
		from {
			opacity: 0;
		}
	}

	.feature-img {
		border-radius: 0;
		border-bottom: 5px solid #4fd1a5;
	}

	.feature-slide:hover .news-img :global(img),
	.news-card:hover .news-img :global(img) {
		transform: scale(1.05);
	}

	.feature-body {
		flex: 1;
		padding: 22px 26px 6px;
	}

	.feature-title {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: clamp(1.2rem, 2vw, 1.6rem);
		font-weight: 700;
		line-height: 1.45;
		color: var(--color-text);
		transition: color 0.2s;
	}

	.feature-slide:hover .feature-title {
		color: var(--color-primary);
	}

	.feature-meta {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 26px 22px;
	}

	.news-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 12px;
		font-size: 0.8rem;
		color: var(--color-muted);
	}

	.news-meta[hidden] {
		display: none;
	}

	.news-meta time {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}

	.news-chip {
		padding: 5px 14px;
		border-radius: 999px;
		background: var(--color-primary);
		color: #fff;
		font-weight: 600;
	}

	.news-cat {
		color: var(--color-primary);
		font-weight: 600;
	}

	.feature-pager {
		display: flex;
		gap: 2px;
		margin-left: auto;
	}

	.feature-pager button {
		min-width: 30px;
		height: 30px;
		border: 0;
		border-radius: 50%;
		background: transparent;
		font: inherit;
		font-weight: 600;
		color: var(--color-text);
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}

	.feature-pager button:hover {
		background: var(--color-primary-soft);
	}

	.feature-pager button.is-active {
		color: #fff;
		background: var(--color-primary);
	}

	.news-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 22px 20px;
		align-content: start;
	}

	.news-grid li {
		margin: 0;
	}

	.news-card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.news-card-title {
		flex: 1;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--color-text);
		transition: color 0.2s;
	}

	.news-card:hover .news-card-title {
		color: var(--color-primary);
	}

	.news-rest {
		margin-top: 24px;
	}

	@media (max-width: 1000px) {
		.news-top {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 520px) {
		/* Compact rows on phones: small picture left, title right */
		.news-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 14px;
		}

		.news-card {
			display: grid;
			grid-template-columns: 120px minmax(0, 1fr);
			grid-template-rows: 1fr auto;
			gap: 4px 12px;
		}

		.news-card .news-img {
			grid-row: 1 / 3;
			align-self: start;
			border-radius: 10px;
		}

		.news-card .news-ph :global(svg) {
			width: 26px;
			height: 26px;
		}

		.news-card-title {
			font-size: 0.9rem;
			line-height: 1.45;
		}

		.news-card .news-meta {
			font-size: 0.72rem;
		}

		.feature-body {
			padding: 18px 18px 4px;
		}

		.feature-meta {
			padding: 8px 18px 18px;
			flex-wrap: wrap;
		}
	}

	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 12px;
	}

	.tabs .button {
		padding: 5px 14px;
		font-size: 0.8rem;
	}

	.empty {
		margin: 0;
		padding: 24px;
		text-align: center;
		color: var(--color-muted);
	}

	/* Calendar */
	.calendar-grid > *,
	.quick-links > * {
		min-width: 0;
	}

	.calendar-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
		align-items: start;
	}

	.calendar {
		display: flex;
		flex-direction: column;
		padding: 16px 18px 20px;
	}

	/* days spread out to fill the box when it is stretched to the video's height */
	.calendar .cal-days {
		flex: 1;
		align-content: space-evenly;
	}

	.cal-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 8px;
		color: var(--color-primary-dark);
	}

	.cal-nav {
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background: #fff;
		color: var(--color-muted);
		cursor: pointer;
	}

	.cal-nav:hover:not(:disabled) {
		color: var(--color-primary);
		border-color: var(--color-primary);
	}

	.cal-nav:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.cal-row[hidden] {
		display: none;
	}

	.cal-days {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 6px 4px;
		text-align: center;
	}

	.cal-dow {
		font-size: 0.75rem;
		color: var(--color-muted);
		padding-bottom: 4px;
	}

	.cal-day {
		display: grid;
		place-items: center;
		height: 36px;
		border-radius: 8px;
		border: 2px solid transparent;
		font-size: 0.9rem;
		font-weight: 500;
	}

	.cal-day.weekend {
		color: var(--color-muted);
	}

	.cal-day.outside {
		color: #c2cfd5;
		font-weight: 400;
	}

	.cal-day.holiday {
		background: #e3e8eb;
		color: var(--color-text);
	}

	.cal-day.event {
		background: var(--color-accent);
		color: #fff;
	}

	.cal-day.today {
		border-color: #111111;
	}

	.events {
		margin-top: 24px;
		padding: 18px 20px 20px;
	}

	.events-title {
		margin: 0 0 12px;
		font-size: 1rem;
		color: var(--color-primary-dark);
	}

	.events ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 12px;
	}

	.events li {
		margin: 0;
	}

	.event-item {
		display: flex;
		align-items: center;
		gap: 14px;
		height: 100%;
		padding: 12px 14px;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: #fbfdfe;
		color: inherit;
		text-decoration: none;
	}

	.event-item > div {
		flex: 1;
		min-width: 0;
	}

	a.event-item {
		transition: border-color 0.15s, background 0.15s, transform 0.15s;
	}

	a.event-item:hover,
	a.event-item:focus-visible {
		border-color: var(--color-primary);
		background: var(--color-primary-soft);
		transform: translateX(2px);
	}

	a.event-item:hover h3 {
		color: var(--color-primary);
	}

	.event-go {
		flex-shrink: 0;
		color: var(--color-muted);
	}

	a.event-item:hover .event-go {
		color: var(--color-primary);
	}

	.event-date {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 48px;
		border-radius: 10px;
		background: var(--c, var(--color-accent));
		color: #fff;
		line-height: 1.1;
		box-shadow: 0 4px 10px -4px var(--c, var(--color-accent));
	}

	.event-date strong {
		font-size: 1.15rem;
	}

	.event-date small {
		font-size: 0.65rem;
		color: rgba(255, 255, 255, 0.85);
	}

	.event-date.holiday {
		background: #e3e8eb;
		color: var(--color-text);
		box-shadow: none;
	}

	.event-date.holiday small {
		color: var(--color-muted);
	}

	.events h3 {
		margin: 0;
		font-size: 0.92rem;
	}

	.events p {
		margin: 2px 0 0;
		font-size: 0.78rem;
		color: var(--color-muted);
	}

	@media (max-width: 860px) {
		.quick-links {
			grid-template-columns: repeat(3, 1fr);
			row-gap: 8px;
		}

		.calendar-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Month calendar in week rows: day numbers on top, events as coloured bars across the days */
	.mc-dows {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		padding-bottom: 4px;
		text-align: center;
		font-size: 0.72rem;
		color: var(--color-muted);
	}

	.mc-weeks {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-evenly;
	}

	.mc-week {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		grid-template-rows: 26px repeat(var(--lanes, 1), 9px);
		row-gap: 2px;
		padding: 3px 0 5px;
		border-top: 1px solid var(--color-border);
	}

	.mc-day {
		grid-row: 1 / -1;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		margin: -3px 1px -5px;
		padding: 3px 0 0;
		border: 0;
		border-radius: 8px;
		background: none;
		font: inherit;
		color: inherit;
	}

	.mc-num {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		font-size: 0.82rem;
		font-weight: 500;
	}

	.mc-day.weekend .mc-num {
		color: var(--color-muted);
	}

	.mc-day.outside .mc-num {
		color: #c2cfd5;
		font-weight: 400;
	}

	.mc-day.holiday {
		background: #e8edf0;
	}

	.mc-day.today .mc-num {
		background: #111111;
		color: #fff;
		font-weight: 700;
	}

	.mc-day.has-ev {
		position: relative;
		cursor: pointer;
	}

	.mc-day.has-ev:hover,
	.mc-day.has-ev:focus-visible {
		outline: none;
		background: rgb(43 179 214 / 10%);
	}

	.mc-day.holiday:hover {
		background: #dfe6ea;
	}

	.mc-day.is-selected {
		box-shadow: inset 0 0 0 2px var(--color-primary);
	}

	.mc-day.has-ev:hover .cal-tip,
	.mc-day.has-ev:focus-visible .cal-tip {
		display: flex;
	}

	.mc-day .cal-tip {
		bottom: auto;
		top: calc(100% + 6px);
	}

	.mc-day .cal-tip::after {
		top: auto;
		bottom: 100%;
		border-top-color: transparent;
		border-bottom-color: #17323d;
	}

	.mc-bar {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		min-width: 0;
		margin: 0 3px;
		padding: 0 6px;
		border: 0;
		border-radius: 999px;
		background: var(--c, var(--color-accent));
		color: #fff;
		font: inherit;
		font-size: 0.62rem;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		cursor: pointer;
	}

	.mc-bar.cont-left {
		margin-left: 0;
		border-top-left-radius: 0;
		border-bottom-left-radius: 0;
	}

	.mc-bar.cont-right {
		margin-right: 0;
		border-top-right-radius: 0;
		border-bottom-right-radius: 0;
	}

	.mc-bar:hover,
	.mc-bar:focus-visible {
		z-index: 5;
		outline: none;
		filter: brightness(1.08);
	}

	/* colour only — the name shows on hover and in the box below */
	.mc-bar-text {
		display: none;
	}

	.mc-tip {
		position: absolute;
		bottom: calc(100% + 6px);
		left: 0;
		z-index: 30;
		display: none;
		flex-direction: column;
		gap: 2px;
		width: max-content;
		max-width: 240px;
		padding: 7px 11px;
		border-radius: 10px;
		background: #17323d;
		color: #fff;
		font-size: 0.76rem;
		font-weight: 400;
		line-height: 1.45;
		white-space: normal;
		text-align: left;
		box-shadow: 0 8px 22px rgb(0 0 0 / 25%);
		pointer-events: none;
	}

	.mc-bar.tip-right .mc-tip {
		left: auto;
		right: 0;
	}

	.mc-tip strong {
		font-weight: 600;
	}

	.mc-tip span {
		color: #b9d2db;
		font-size: 0.7rem;
	}

	.mc-bar:hover .mc-tip,
	.mc-bar:focus-visible .mc-tip {
		display: flex;
	}

	.cal-detail .ev-range {
		margin: 1px 0 0;
		font-size: 0.7rem;
		color: var(--color-primary-dark);
	}

	/* Homepage grid: ข่าวรับสมัครสอบ across; news | calendar; documents across */
	.home-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
		gap: 40px 28px;
		align-items: start;
		margin-top: 40px;
	}

	.hg-cell {
		min-width: 0;
		margin-top: 0;
	}

	.hg-recruit { grid-column: 1 / -1; grid-row: 1; }
	.hg-news { grid-column: 1; grid-row: 2; }
	.hg-cal { grid-column: 2; grid-row: 2; }
	.hg-docs { grid-column: 1 / -1; grid-row: 3; }

	/* performance items in the news list: play mark over the picture */
	.news-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.news-play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: #fff;
		background: rgb(0 0 0 / 0.18);
		pointer-events: none;
	}


	.home-grid [hidden] {
		display: none !important;
	}

	/* clickable calendar days: hover shows the events, click lists them in the box below */
	.cal-day.has-ev {
		position: relative;
		padding: 0;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
	}

	.cal-day.has-ev:not(.event):not(.holiday) {
		background: none;
	}

	.cal-day.has-ev:hover,
	.cal-day.has-ev:focus-visible {
		outline: none;
		box-shadow: 0 0 0 3px rgb(43 179 214 / 35%);
	}

	.cal-day.is-selected {
		border-color: var(--color-primary-dark);
		box-shadow: 0 0 0 3px rgb(43 179 214 / 35%);
	}

	.cal-tip {
		position: absolute;
		bottom: calc(100% + 8px);
		left: 50%;
		z-index: 20;
		display: none;
		flex-direction: column;
		gap: 4px;
		width: max-content;
		max-width: 240px;
		padding: 8px 12px;
		border-radius: 10px;
		background: #17323d;
		color: #fff;
		font-size: 0.8rem;
		font-weight: 500;
		line-height: 1.4;
		text-align: left;
		transform: translateX(-50%);
		box-shadow: 0 8px 22px rgb(0 0 0 / 25%);
		pointer-events: none;
	}

	.cal-tip::after {
		content: "";
		position: absolute;
		top: 100%;
		left: 50%;
		border: 6px solid transparent;
		border-top-color: #17323d;
		transform: translateX(-50%);
	}

	.cal-tip.tip-left {
		left: 0;
		transform: none;
	}

	.cal-tip.tip-left::after {
		left: 14px;
	}

	.cal-tip.tip-right {
		left: auto;
		right: 0;
		transform: none;
	}

	.cal-tip.tip-right::after {
		left: auto;
		right: 8px;
	}

	.cal-tip-item {
		display: block;
		padding-left: 12px;
		position: relative;
	}

	.cal-tip-item::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.5em;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-accent);
	}

	.cal-tip-item.holiday::before {
		background: #c2cfd5;
	}

	.cal-day.has-ev:hover .cal-tip,
	.cal-day.has-ev:focus-visible .cal-tip {
		display: flex;
	}

	@media (hover: none) {
		.cal-day.has-ev:hover .cal-tip {
			display: none;
		}
	}

	.cal-detail {
		margin-top: 14px;
	}

	.cal-detail ul {
		grid-template-columns: minmax(0, 1fr);
		gap: 8px;
	}

	/* smaller text in the day's event box */
	.cal-detail {
		padding: 14px 16px 16px;
	}

	.cal-detail .events-title {
		margin-bottom: 8px;
		font-size: 0.85rem;
	}

	.cal-detail .event-item {
		gap: 10px;
	}

	.cal-detail .event-item h3 {
		font-size: 0.8rem;
		line-height: 1.4;
	}

	.cal-detail .event-item p {
		font-size: 0.72rem;
	}

	.cal-detail .event-date {
		width: 36px;
		height: 40px;
		border-radius: 8px;
	}

	.cal-detail .event-date strong {
		font-size: 0.95rem;
	}

	.cal-detail .event-date small {
		font-size: 0.58rem;
	}

	.cal-detail .cal-hint {
		font-size: 0.8rem;
	}

	.cal-detail ul:not(:has(li:not([hidden]))) {
		display: none;
	}

	.cal-hint {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		margin: 0;
		font-size: 0.88rem;
		color: var(--color-muted);
	}

	/* news in the left column: big story on top, the other four in a row under it */
	.hg-news .news-top {
		grid-template-columns: minmax(0, 1fr);
	}

	.hg-news .news-grid {
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 18px 16px;
	}

	/* documents: full width, fixed page size */
	.hg-docs {
		display: flex;
		flex-direction: column;
	}

	.hg-docs .tabs {
		margin-bottom: 12px;
	}

	/* ข้าราชการ / ลูกจ้าง beside the heading */
	.docs-aud {
		display: inline-flex;
		align-self: center;
		gap: 2px;
