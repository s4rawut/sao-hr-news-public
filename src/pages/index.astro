---
import { siteLink } from "../utils/site-link";
import {
	getEmDashCollection,
	getSiteSettings,
	getTaxonomyTermsWithCacheHint,
	getTermsForEntries,
} from "../lib/cms";
import Image from "../components/cms/Image.astro";
import Icon from "../components/Icon.astro";
import RecruitLevels from "../components/RecruitLevels.astro";
import EntryBanner from "../components/EntryBanner.astro";
import WelcomePopup from "../components/WelcomePopup.astro";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { getRecruitData } from "../utils/recruit";
import { byPostDate, postDate, showNewBadge } from "../utils/post-date";
import { dayNo, layoutBars, toCalEvent, weekdayOf } from "../utils/event-days";
import { getEventTypes } from "../utils/event-types";
import { getSiteInfo, mediaUrl, quickLinkIcons } from "../utils/site-info";
import { formatThaiMonth, resolveVideo } from "../utils/video";
import {
	adminDateTime,
	bangkokParts,
	formatThaiAgo,
	formatThaiCompact,
	formatThaiShort,
	thaiMonths,
	thaiMonthsShort,
	thaiWeekdaysShort,
} from "../utils/thai-date";

const now = new Date();

const [info, settings, termsResult, audienceResult] = await Promise.all([
	getSiteInfo(),
	getSiteSettings(),
	getTaxonomyTermsWithCacheHint("category"),
	// "กลุ่มผู้ใช้คลังข้อมูล" (ข้าราชการ / ลูกจ้าง): the switch beside the คลังข้อมูล heading
	getTaxonomyTermsWithCacheHint("post_audience"),
]);
const postAudiences = audienceResult.data.map((t) => ({ slug: t.slug, label: t.label }));

// "คลังข้อมูล" = every post; its chips are the categories under Categories (ประกาศ / คำสั่ง /
// ระเบียบ / หลักเกณฑ์ / บันทึกข้อความ), all shown even when empty.
const documentCategories = termsResult.data.map((t) => ({ slug: t.slug, label: t.label }));
const docsSeeAll = "/posts";
// the chip selected when the page opens: คำสั่ง (slug "order"), or the first one if it is gone
const docsDefault = documentCategories.some((c) => c.slug === "order") ? "order" : documentCategories[0]?.slug;

const sortByOrder = <T extends { data: { sort_order?: number } }>(items: T[]) =>
	[...items].sort((a, b) => (a.data.sort_order ?? Infinity) - (b.data.sort_order ?? Infinity));

const [quickResult, recruitData, newsResult, docsResult, eventsResult, perfResult] = await Promise.all([
	getEmDashCollection("quick_links", { limit: 50 }),
	getRecruitData(),
	// Every post in คลังข้อมูล: pinned ones ("ปักหมุดที่ข่าวประชาสัมพันธ์") also show in the news tab.
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 300,
	}),
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 300,
	}),
	getEmDashCollection("events", { orderBy: { event_date: "asc" }, limit: 500 }),
	getEmDashCollection("performance", { orderBy: { report_month: "desc" }, limit: 4 }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(info.cacheHint);
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(audienceResult.cacheHint);
	for (const hint of recruitData.cacheHints) Astro.cache.set(hint);
	for (const r of [quickResult, newsResult, docsResult, eventsResult, perfResult]) {
		if (r.cacheHint) Astro.cache.set(r.cacheHint);
	}
}

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(settings);
// Hero text is optional: empty fields show the image alone, without the dark overlay.
const heroTitle = info.hero_title.trim();
const heroSubtitle = info.hero_subtitle.trim();
const heroHasText = !!(heroTitle || heroSubtitle);
// A banner without overlay text keeps its own proportions, so the words drawn into the image are
// never cropped (on phones the box gets shorter instead of cutting the sides).
const heroRatio =
	info.hero_image?.width && info.hero_image?.height ? `${info.hero_image.width} / ${info.hero_image.height}` : "2.9 / 1";
const quickLinks = sortByOrder(quickResult.entries);

// ผลการดำเนินการประจำเดือน: the latest months join the ข่าวประชาสัมพันธ์ list, after the pinned items.
const perfMonth = (e: (typeof perfResult.entries)[number]) =>
	formatThaiMonth(new Date(e.data.report_month as unknown as string));
const perfThumb = (e: (typeof perfResult.entries)[number]) => {
	const v = resolveVideo(e.data);
	return mediaUrl(e.data.poster) ?? (v?.kind === "embed" ? v.thumbnail : undefined);
};
const news = byPostDate(newsResult.entries);

const categoryByEntry = await getTermsForEntries(
	"posts",
	docsResult.entries.map((p) => p.data.id),
	"category",
);
// กลุ่มผู้ใช้ of each post: ลูกจ้าง shows only posts ticked ลูกจ้าง; ข้าราชการ also shows posts with none ticked
const audienceByEntry = await getTermsForEntries(
	"posts",
	docsResult.entries.map((p) => p.data.id),
	"post_audience",
);
const docs = byPostDate(docsResult.entries).map((post) => {
	const term = (categoryByEntry.get(post.data.id) ?? [])[0];
	const audiences = (audienceByEntry.get(post.data.id) ?? []).map((t) => t.slug);
	return { post, category: term, audiences };
});

// News tab: items pinned with "ปักหมุดที่ข่าวประชาสัมพันธ์ หน้าแรก: ลำดับที่", from คลังข้อมูล posts and
// from "ไฟล์เอกสารในหน้าเว็บ" — 1 = big card, 2–5 = the cards beside it. Nothing pinned = an empty note.
const isPinned = (o: unknown) => typeof o === "number" && o > 0;
const pinnedPosts = news.filter((p) => isPinned(p.data.featured_order));
const pinnedFilesResult = await getEmDashCollection("infographics", { limit: 500 });
if (Astro.cache?.enabled && pinnedFilesResult.cacheHint) Astro.cache.set(pinnedFilesResult.cacheHint);
const pinnedFiles = pinnedFilesResult.entries.filter((g) => isPinned(g.data.featured_order));
const newsTerms = await getTermsForEntries(
	"posts",
	pinnedPosts.map((p) => p.data.id),
	"category",
);
type NewsItem = {
	key: string;
	title: string;
	href: string;
	image?: (typeof news)[number]["data"]["featured_image"];
	/** picture by address (performance poster / video thumbnail), when there is no image object */
	imageUrl?: string;
	video?: boolean;
	date?: Date;
	label?: string;
	edit?: Record<string, unknown>;
	isNew: boolean;
	order: number;
};
const newsItems: NewsItem[] = [
	...pinnedPosts.map((p) => ({
		key: p.data.id,
		title: p.data.title,
		href: `/posts/${p.id}`,
		image: p.data.featured_image,
		date: postDate(p),
		// the post's category in คลังข้อมูล (ประกาศ / คำสั่ง …), if it has one
		label: (newsTerms.get(p.data.id) ?? [])[0]?.label,
		edit: p.edit.title as Record<string, unknown>,
		isNew: showNewBadge(p, info.new_badge_days, now.getTime()),
		order: p.data.featured_order as number,
	})),
	...pinnedFiles.map((g) => ({
		key: g.data.id,
		title: g.data.title,
		// a PDF link opens in the site's preview window
		href: mediaUrl(g.data.file) ?? "/",
		image: g.data.featured_image as NewsItem["image"],
		date: postDate(g),
		label: "เอกสาร",
		isNew: showNewBadge(g, info.new_badge_days, now.getTime()),
		order: g.data.featured_order as number,
	})),
].sort((a, b) => a.order - b.order || (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));
// then the newest months of ผลการดำเนินการ (newest first), each linking to its video page
newsItems.push(
	...perfResult.entries.map((e) => ({
		key: e.data.id,
		title: e.data.title,
		href: `/performance/${encodeURIComponent(e.id)}`,
		imageUrl: perfThumb(e),
		video: true,
		date: new Date(e.data.report_month as unknown as string),
		label: `ผลการดำเนินการ ${perfMonth(e)}`,
		edit: e.edit.title as Record<string, unknown>,
		isNew: false,
		order: Infinity,
	})),
);
const headline = newsItems.slice(0, 9);
const newsGridCount = Math.min(8, Math.max(0, headline.length - 1));
const newsSlides = headline.slice(0, 1);
const newsGrid = headline.slice(1, 1 + newsGridCount);



// Calendar: every month from a year back to a year ahead (stretched to cover all events) is
// rendered; the arrows switch months in the browser. ?m=YYYY-MM picks the month shown first.
const today = bangkokParts(now);
const monthParam = Astro.url.searchParams.get("m");
let calYear = today.year;
let calMonth = today.month;
if (monthParam && /^\d{4}-\d{2}$/.test(monthParam)) {
	const [y, m] = monthParam.split("-").map(Number);
	if (m >= 1 && m <= 12) {
		calYear = y;
		calMonth = m - 1;
	}
}
const monthKey = (y: number, m: number) => {
	const d = new Date(Date.UTC(y, m, 1));
	return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}`;
};
const initialMonth = monthKey(calYear, calMonth);

const allEvents = eventsResult.entries.map((e) => ({ entry: e, date: adminDateTime(e.data.event_date) }));
const monthIndex = (y: number, m: number) => y * 12 + m;
const eventIdx = allEvents.map(({ date }) => {
	const p = bangkokParts(date);
	return monthIndex(p.year, p.month);
});
const baseIdx = monthIndex(today.year, today.month);
const fromIdx = Math.max(baseIdx - 36, Math.min(baseIdx - 12, monthIndex(calYear, calMonth), ...eventIdx));
const toIdx = Math.min(baseIdx + 36, Math.max(baseIdx + 12, monthIndex(calYear, calMonth), ...eventIdx));

// Each month is drawn in week rows, the same way as the yearly calendar: day numbers on top and
// every event as a bar in its "ประเภทกิจกรรม" colour running from "วันที่" to "ถึงวันที่".
const eventTypes = await getEventTypes();
if (Astro.cache?.enabled && eventTypes.cacheHint) Astro.cache.set(eventTypes.cacheHint);
const calEvents = eventsResult.entries.map((e) => toCalEvent(e, eventTypes.colorOf));
const todayNo = dayNo(today);
const calMonths = Array.from({ length: toIdx - fromIdx + 1 }, (_, n) => {
	const idx = fromIdx + n;
	const y = Math.floor(idx / 12);
	const m = idx % 12;
	const firstNo = dayNo({ year: y, month: m, day: 1 });
	const lastNo = dayNo({ year: y, month: m + 1, day: 0 });
	const gridStart = firstNo - weekdayOf(firstNo);
	const weekCount = Math.ceil((lastNo - gridStart + 1) / 7);
	const weeks = Array.from({ length: weekCount }, (_, w) => {
		const ws = gridStart + w * 7;
		const cells = Array.from({ length: 7 }, (_, i) => {
			const no = ws + i;
			const touching = calEvents.filter((e) => e.start <= no && e.end >= no);
			return {
				no,
				day: new Date(no * 86_400_000).getUTCDate(),
				col: i,
				outside: no < firstNo || no > lastNo,
				weekend: i === 0 || i === 6,
				today: no === todayNo,
				holiday: touching.filter((e) => e.holiday).map((e) => e.title).join(", "),
				titles: touching.map((e) => e.title),
			};
		});
		const { pieces, lanes } = layoutBars(calEvents, ws, ws + 6);
		return { cells, pieces, lanes: Math.max(1, lanes) };
	});
	return { key: monthKey(y, m), y, m, weeks, first: n === 0, last: idx === toIdx };
});
---

<Base title={siteTitle} description={siteTagline} fullWidth>
	<section class:list={["hero", { "has-text": heroHasText }]} aria-label={heroHasText ? undefined : siteTitle} style={`--hero-ratio: ${heroRatio}`}>
		{
			info.hero_image ? (
				<div class="hero-bg" {...info.entry?.edit.hero_image}>
					<Image image={info.hero_image} alt={info.hero_image.alt || ""} loading="eager" />
				</div>
			) : (
				<div class="hero-bg hero-bg-default" />
			)
		}
		<div class="container hero-text">
			{heroTitle ? <h1>{heroTitle}</h1> : <h1 class="sr-only">{siteTitle}</h1>}
			{heroSubtitle && <p>{heroSubtitle}</p>}
		</div>
	</section>

	<div class="container">
		{
			quickLinks.length > 0 && (
				<nav
					class="quick-links card"
					aria-label="ระบบงานที่ใช้บ่อย"
					style={`--ql-cols: ${Math.min(quickLinks.length, 6)}`}
				>
					{quickLinks.map((link) => (
						<a
							href={siteLink(link.data.url)}
							target={link.data.new_tab ? "_blank" : undefined}
							rel={link.data.new_tab ? "noopener noreferrer" : undefined}
						>
							<span class="ql-icon">
								{link.data.icon_image ? (
									<Image image={link.data.icon_image} alt="" width={28} height={28} />
								) : (
									<Icon name={quickLinkIcons[link.data.icon ?? ""] ?? "link"} />
								)}							</span>
							<span class="ql-label" {...link.edit.title}>{link.data.title}</span>
						</a>
					))}
				</nav>
			)
		}

		{/* ข่าวรับสมัครสอบ across the top, then ข่าวประชาสัมพันธ์ | ปฏิทินกิจกรรม, then the documents across */}
		<div class="home-grid">
			{recruitData.levels.length > 0 && (
				<section class="hg-cell hg-recruit" id="recruit">
					<h2 class="section-title">
						{info.heading_recruitments}
						<a href="/recruitments" class="see-all">ดูทั้งหมด</a>
					</h2>
					<RecruitLevels types={recruitData.types} stageOf={recruitData.stageOf} />
				</section>
			)}

			<section class="hg-cell hg-news" id="news">
				<h2 class="section-title">
					{info.heading_news}
					<a href="/posts" class="see-all">ดูทั้งหมด</a>
				</h2>
				{
					headline.length === 0 ? (
						<div class="card">
							<p class="empty">ยังไม่มีข่าวประชาสัมพันธ์</p>
						</div>
					) : (
						<div>
							<div class:list={["news-top", { "no-grid": newsGrid.length === 0 }]} data-news-all>
								<div class="news-feature card" data-slider>
									{newsSlides.map((item, i) => (
										<a href={item.href} class="feature-slide" data-slide hidden={i !== 0}>
											<span class="news-img feature-img">
												{item.image ? (
													<Image image={item.image} alt={item.image.alt || ""} loading={i === 0 ? "eager" : "lazy"} />
												) : item.imageUrl ? (
													<img src={item.imageUrl} alt="" loading={i === 0 ? "eager" : "lazy"} />
												) : (
													<span class="news-ph" aria-hidden="true"><Icon name="office" size={64} /></span>
												)}
												{item.video && <span class="news-play" aria-hidden="true"><Icon name="play" size={28} /></span>}
											</span>
											<span class="feature-body">
												<span class="feature-title" {...(item.edit ?? {})}>{item.title}</span>
											</span>
										</a>
									))}
									<div class="feature-meta">
										{newsSlides.map((item, i) => (
											<span class="news-meta" data-slide-meta hidden={i !== 0}>
												{item.label && <span class="news-chip">{item.label}</span>}
												{item.date && (
													<time datetime={item.date.toISOString()}>
														<Icon name="clock" size={14} /> {formatThaiAgo(item.date, now)}
													</time>
												)}
												{item.isNew && <span class="badge-new">ใหม่</span>}
											</span>
										))}
										{newsSlides.length > 1 && (
											<span class="feature-pager" role="group" aria-label="เลือกข่าวเด่น">
												{newsSlides.map((_, i) => (
													<button type="button" data-goto={i} class:list={{ "is-active": i === 0 }} aria-label={`ข่าวเด่นที่ ${i + 1}`}>
														{i + 1}
													</button>
												))}
											</span>
										)}
									</div>
								</div>

								{newsGrid.length > 0 && (
									<ul class="news-grid">
										{newsGrid.map((item) => (
											<li>
												<a href={item.href} class="news-card">
													<span class="news-img">
														{item.image ? (
															<Image image={item.image} alt={item.image.alt || ""} />
														) : item.imageUrl ? (
															<img src={item.imageUrl} alt="" loading="lazy" />
														) : (
															<span class="news-ph" aria-hidden="true"><Icon name="office" size={36} /></span>
														)}
														{item.video && <span class="news-play" aria-hidden="true"><Icon name="play" size={18} /></span>}
													</span>
													<span class="news-card-title" {...(item.edit ?? {})}>{item.title}</span>
													<span class="news-meta">
														{item.date && (
															<time datetime={item.date.toISOString()}>
																<Icon name="clock" size={13} /> {formatThaiAgo(item.date, now)}
															</time>
														)}
														{item.label && <span class="news-cat">{item.label}</span>}
														{item.isNew && <span class="badge-new">ใหม่</span>}
													</span>
												</a>
											</li>
										))}
									</ul>
								)}
							</div>

						</div>
					)
				}
			</section>


			<section class="hg-cell hg-cal" id="calendar">
				<h2 class="section-title">
					{info.heading_calendar}
					<small>วันนี้ {formatThaiCompact(now)}</small>
					{info.show_year_calendar && <a href="/calendar" class="see-all">ดูทั้งหมด</a>}
				</h2>
				<div data-calendar>
					{calMonths.map((cm) => (
							<div class="card calendar" data-cal-month={cm.key} hidden={cm.key !== initialMonth}>
								<div class="cal-head">
									<button type="button" class="cal-nav" data-cal-step="-1" aria-label="เดือนก่อนหน้า" disabled={cm.first}>
										<Icon name="chevron-left" size={14} />
									</button>
									<strong>{thaiMonths[cm.m]} {cm.y + 543}</strong>
									<button type="button" class="cal-nav" data-cal-step="1" aria-label="เดือนถัดไป" disabled={cm.last}>
										<Icon name="chevron-right" size={14} />
									</button>
								</div>
								<div class="mc-dows">
									{thaiWeekdaysShort.map((d) => <span>{d}</span>)}
								</div>
								<div class="mc-weeks">
									{cm.weeks.map((wk) => (
										<div class="mc-week" style={`--lanes: ${wk.lanes}`}>
											{wk.cells.map((c) =>
												c.titles.length > 0 ? (
													<button
														type="button"
														class:list={["mc-day", "has-ev", { outside: c.outside, weekend: c.weekend, today: c.today, holiday: !!c.holiday }]}
														style={`grid-column: ${c.col + 1}`}
														data-cal-day={c.no}
														aria-label={`${c.day}: ${c.titles.join(", ")}`}
													>
														<span class="mc-num">{c.day}</span>
														{c.holiday && (
															<span class:list={["cal-tip", { "tip-left": c.col <= 1, "tip-right": c.col >= 5 }]} aria-hidden="true">
																<span class="cal-tip-item holiday">{c.holiday}</span>
															</span>
														)}
													</button>
												) : (
													<span class:list={["mc-day", { outside: c.outside, weekend: c.weekend, today: c.today }]} style={`grid-column: ${c.col + 1}`}>
														<span class="mc-num">{c.day}</span>
													</span>
												),
											)}
											{wk.pieces.map((p) => {
												const style = `grid-column: ${p.from} / ${p.to + 1}; grid-row: ${p.lane + 2}; --c: ${p.e.color}`;
												const cls = ["mc-bar", { "cont-left": p.contLeft, "cont-right": p.contRight, "tip-right": p.from >= 5 }];
												const body = (
													<>
														<span class="mc-bar-text">{p.e.title}</span>
														<span class="mc-tip" aria-hidden="true">
															<strong>{p.e.title}</strong>
															<span>{p.e.range}{p.e.type ? ` · ${p.e.type}` : ""}</span>
														</span>
													</>
												);
												return p.e.link ? (
													<a class:list={cls} style={style} href={p.e.link} target={p.e.external ? "_blank" : undefined} rel={p.e.external ? "noopener noreferrer" : undefined} aria-label={`${p.e.title} (${p.e.range})`}>
														{body}
													</a>
												) : (
													<button type="button" class:list={cls} style={style} data-cal-day={Math.max(p.e.start, wk.cells[0].no)} aria-label={`${p.e.title} (${p.e.range})`}>
														{body}
													</button>
												);
											})}
										</div>
									))}
								</div>
							</div>
					))}
				</div>
				<div class="card events cal-detail" data-cal-detail aria-live="polite">
					<p class="cal-hint" data-cal-hint>
						<Icon name="calendar" size={16} /> คลิกวันที่มีสี เพื่อดูรายละเอียดกิจกรรม
					</p>
					<h3 class="events-title" data-cal-detail-title hidden></h3>
					<ul>
						{calEvents.map((e) => {
							const inner = (
								<>
									<span class:list={["event-date", { holiday: e.holiday }]} style={e.holiday ? undefined : `--c: ${e.color}`}>
										<strong>{new Date(e.start * 86_400_000).getUTCDate()}</strong>
										<small>{thaiMonthsShort[new Date(e.start * 86_400_000).getUTCMonth()]}</small>
									</span>
									<div>
										<h3>{e.title}</h3>
										<p class="ev-range">{e.range}{e.holiday ? " · วันหยุด" : e.type ? ` · ${e.type}` : ""}</p>
										{e.description && <p>{e.description}</p>}
									</div>
									{e.link && <span class="event-go" aria-hidden="true"><Icon name="chevron-right" size={16} /></span>}
								</>
							);
							return (
								<li data-ev-start={e.start} data-ev-end={e.end} hidden>
									{e.link ? (
										<a class="event-item is-link" href={e.link} target={e.external ? "_blank" : undefined} rel={e.external ? "noopener noreferrer" : undefined}>
											{inner}
										</a>
									) : (
										<div class="event-item">{inner}</div>
									)}
								</li>
							);
						})}
					</ul>
				</div>
			</section>

			<section class="hg-cell hg-docs docs" id="docs" data-limit={info.documents_limit} data-see-all={docsSeeAll}>
				<h2 class="section-title">
					{info.heading_documents}
					{postAudiences.length > 0 && (
						<span class="docs-aud" role="group" aria-label="กลุ่มผู้ใช้">
							{postAudiences.map((a, i) => (
								<button type="button" class:list={{ "is-active": i === 0 }} data-aud={a.slug} aria-pressed={i === 0 ? "true" : "false"}>
									{a.label}
									<span class="aud-badge" data-aud-badge hidden></span>
								</button>
							))}
						</span>
					)}
					<a href={docsSeeAll} class="see-all" data-docs-see-all>ดูทั้งหมด</a>
				</h2>
					<div class="tabs" role="tablist" aria-label="หมวดหมู่เอกสาร" hidden={documentCategories.length === 0}>
						{
							documentCategories.map((c) => (
								<button type="button" class:list={["button", { "is-active": c.slug === docsDefault }]} data-filter={c.slug} data-default={c.slug === docsDefault ? "" : undefined} role="tab" aria-selected={c.slug === docsDefault ? "true" : "false"}>
									{c.label}
								</button>
							))
						}
					</div>
					<div class="card docs-card">
						<ul class="item-list" data-docs-list>
							{
								docs.map(({ post, category, audiences }) => (
									<li data-cat={category?.slug ?? ""} data-aud={audiences.join(" ")} data-id={post.id} data-new={showNewBadge(post, info.new_badge_days, now.getTime()) ? "" : undefined}>
										<a href={`/posts/${post.id}`}>
											<span>
												<span class="item-meta">
													{category && <span class="chip">{category.label}</span>}
													{postDate(post) && (
														<time datetime={postDate(post)!.toISOString()}>
															{formatThaiShort(postDate(post)!)}
														</time>
													)}
												</span>
												<span class="item-title" {...post.edit.title}>{post.data.title}</span>
											</span>
											{showNewBadge(post, info.new_badge_days, now.getTime()) && <span class="badge-new">ใหม่</span>}
										</a>
									</li>
								))
							}
						</ul>
						<p class="empty" data-empty hidden>ยังไม่มีรายการในหมวดนี้</p>
						<nav class="docs-pager" data-docs-pager aria-label="หน้ารายการเอกสาร" hidden>
							<button type="button" class="pg-btn" data-pg-step="-1" aria-label="หน้าก่อนหน้า"><Icon name="chevron-left" size={14} /></button>
							<span class="pg-info" data-pg-info></span>
							<button type="button" class="pg-btn" data-pg-step="1" aria-label="หน้าถัดไป"><Icon name="chevron-right" size={14} /></button>
						</nav>
					</div>
			</section>

		</div>
	</div>

	<EntryBanner />
	{info.show_welcome_popup && <WelcomePopup />}

	<aside class="line-friend" data-line-friend aria-label="เพิ่มเพื่อน LINE SAO HR">
		<button type="button" class="line-friend-close" data-line-friend-close aria-label="ปิด">×</button>
		<img
			src="/images/line-friend.webp"
			alt="มาเป็นเพื่อนกัน — สแกน QR code เพื่อเพิ่มเพื่อน LINE SAO HR"
			width="360"
			height="360"
			loading="lazy"
			decoding="async"
		/>
	</aside>
</Base>

