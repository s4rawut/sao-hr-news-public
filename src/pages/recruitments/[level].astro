---
import { postDate } from "../../utils/post-date";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { decodeSlug } from "../../lib/cms";
import RecruitList from "../../components/RecruitList.astro";
import Base from "../../layouts/Base.astro";
import { getRecruitData } from "../../utils/recruit";
import { getSiteInfo } from "../../utils/site-info";
import { adminDateTime, bangkokParts } from "../../utils/thai-date";

// One position level (e.g. วิชาการ › ระดับชำนาญการ): its announcements, newest first.
const slug = decodeSlug(Astro.params.level);
const [data, info] = await Promise.all([getRecruitData(), getSiteInfo()]);
const level = data.levels.find((l) => l.slug === slug);
if (!level) {
	return Astro.rewrite("/404");
}
if (Astro.cache?.enabled) {
	for (const hint of data.cacheHints) Astro.cache.set(hint);
	Astro.cache.set(info.cacheHint);
}
const siblings = data.types.find((t) => t.slug === level.typeSlug)?.levels ?? [];
// Year tabs (พ.ศ.): an announcement's "ปี" field, otherwise the year of its first application day,
// otherwise the year of its "วันที่ประกาศ". New years appear as tabs on their own, newest first.
const yearOf = (e: (typeof level.entries)[number]) => {
	if (e.data.year) return e.data.year;
	const d = e.data.apply_start ? adminDateTime(e.data.apply_start) : postDate(e);
	return d ? bangkokParts(new Date(d)).year + 543 : undefined;
};
const years = [...new Set(level.entries.map(yearOf).filter((y): y is number => !!y))].sort((a, b) => b - a);
const noYear = level.entries.filter((e) => !yearOf(e));
// Banner per level, drawn in the page (no image to maintain): colour and icon follow the position
// type, so a new level added in the admin gets one automatically. Same colours as the type boxes in
// RecruitLevels.astro: บริหาร ฟ้า, อำนวยการ ทอง, วิชาการ เขียว, ทั่วไป ม่วง.
const THEMES: Record<string, { c1: string; c2: string; acc: string; icon: string }> = {
	executive: { c1: "#0284c7", c2: "#075985", acc: "#ffd166", icon: "crown" },
	director: { c1: "#b8860b", c2: "#7a5200", acc: "#fff3c4", icon: "team" },
	academic: { c1: "#15803d", c2: "#14532d", acc: "#ffd166", icon: "book" },
	general: { c1: "#7c3aed", c2: "#4c1d95", acc: "#ffd166", icon: "gear" },
};
const theme = THEMES[level.typeSlug] ?? THEMES.academic;
const latestStage = level.entries[0] ? data.stageOf(level.entries[0].data.id) : undefined;
const title = `${info.heading_recruitments} ประเภท${level.typeLabel} ${level.label}`;
---

<Base title={title}>
	<Breadcrumbs items={[{ label: info.heading_recruitments, href: "/recruitments" }, { label: `ประเภท${level.typeLabel}` }]} />

	<header class="level-banner" style={`--c1:${theme.c1};--c2:${theme.c2};--acc:${theme.acc}`}>
		<div class="lb-text">
			<span class="lb-tag">{info.heading_recruitments}</span>
			<h1 class="lb-title">
				<span>ตำแหน่งประเภท{level.typeLabel}</span>
				<span>{level.label}</span>
			</h1>
			{level.description ? (
				<p class="lb-sub">{level.description}</p>
			) : (
				latestStage?.period && <p class="lb-sub">รับสมัคร {latestStage.period}</p>
			)}
		</div>
		<svg class="lb-icon" viewBox="0 0 200 200" aria-hidden="true">
			<circle cx="100" cy="100" r="92" fill="#fff" opacity=".1" />
			<circle cx="100" cy="100" r="70" fill="#fff" />
			{theme.icon === "crown" && (
				<g fill="var(--acc)" stroke="var(--c2)" stroke-width="5" stroke-linejoin="round">
					<path d="M52 128 L46 74 L76 98 L100 62 L124 98 L154 74 L148 128 Z" />
					<rect x="52" y="128" width="96" height="16" rx="4" />
				</g>
			)}
			{theme.icon === "team" && (
				<g fill="var(--c1)">
					<circle cx="100" cy="76" r="18" />
					<path d="M70 132 a30 30 0 0 1 60 0 z" />
					<circle cx="64" cy="92" r="12" fill="var(--acc)" />
					<path d="M44 132 a20 20 0 0 1 40 0 z" fill="var(--acc)" />
					<circle cx="136" cy="92" r="12" fill="var(--acc)" />
					<path d="M116 132 a20 20 0 0 1 40 0 z" fill="var(--acc)" />
				</g>
			)}
			{theme.icon === "book" && (
				<g stroke="var(--c2)" stroke-width="5" stroke-linejoin="round">
					<path d="M100 72 C84 62 62 62 50 66 V136 C62 132 84 132 100 142 Z" fill="var(--acc)" />
					<path d="M100 72 C116 62 138 62 150 66 V136 C138 132 116 132 100 142 Z" fill="#fff" />
					<path d="M112 86 h26 M112 100 h26 M112 114 h20" stroke="var(--c1)" />
				</g>
			)}
			{theme.icon === "gear" && (
				<g fill="var(--c1)">
					<path d="M92 50 h16 l4 16 a38 38 0 0 1 12 7 l15 -6 l8 14 l-12 11 a38 38 0 0 1 0 14 l12 11 l-8 14 l-15 -6 a38 38 0 0 1 -12 7 l-4 16 h-16 l-4 -16 a38 38 0 0 1 -12 -7 l-15 6 l-8 -14 l12 -11 a38 38 0 0 1 0 -14 l-12 -11 l8 -14 l15 6 a38 38 0 0 1 12 -7 z" />
					<circle cx="100" cy="100" r="16" fill="var(--acc)" />
				</g>
			)}
		</svg>
	</header>

	{
		siblings.length > 1 && (
			<div class="level-tabs" role="navigation" aria-label={`ระดับในประเภท${level.typeLabel}`}>
				{siblings.map((s) => (
					<a
						href={`/recruitments/${encodeURIComponent(s.slug)}`}
						class:list={{ active: s.slug === level.slug }}
						aria-current={s.slug === level.slug ? "page" : undefined}
					>
						{s.label} <small>({s.entries.length})</small>
					</a>
				))}
			</div>
		)
	}

	{
		years.length === 0 ? (
			<RecruitList entries={level.entries} stageOf={data.stageOf} />
		) : (
			<div class="year-wrap" data-years>
				<div class="year-tabs" role="tablist" aria-label="ปี">
					{years.map((y, i) => (
						<button type="button" role="tab" class:list={{ active: i === 0 }} aria-selected={i === 0 ? "true" : "false"} data-year={y}>
							ปี {y}
						</button>
					))}
				</div>
				{years.map((y, i) => (
					<div class="year-panel" data-year-panel={y} hidden={i !== 0}>
						<RecruitList entries={[...level.entries.filter((e) => yearOf(e) === y), ...(i === 0 ? noYear : [])]} stageOf={data.stageOf} />
					</div>
				))}
			</div>
		)
	}

<script>
	document.querySelectorAll<HTMLElement>("[data-years]").forEach((root) => {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-year]")];
		const panels = [...root.querySelectorAll<HTMLElement>("[data-year-panel]")];
		const show = (y: string) => {
			tabs.forEach((t) => {
				t.classList.toggle("active", t.dataset.year === y);
				t.setAttribute("aria-selected", String(t.dataset.year === y));
			});
			panels.forEach((p) => (p.hidden = p.dataset.yearPanel !== y));
		};
		tabs.forEach((t) => t.addEventListener("click", () => show(t.dataset.year!)));
		// A link to #recruit-<slug> (e.g. from search) opens the year holding it.
		const id = decodeURIComponent(location.hash.slice(1));
		const target = id ? document.getElementById(id) : null;
		const panel = target?.closest<HTMLElement>("[data-year-panel]");
		if (panel) show(panel.dataset.yearPanel!);
	});
</script>
</Base>

<style>
	.level-banner {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		min-height: 200px;
		margin-bottom: 22px;
		padding: 32px clamp(22px, 5vw, 56px);
		border-radius: 20px;
		overflow: hidden;
		color: #fff;
		background:
			radial-gradient(rgba(255, 255, 255, 0.08) 2px, transparent 2px) 0 0 / 26px 26px,
			linear-gradient(135deg, var(--c1), var(--c2));
	}

	.level-banner::after {
		content: "";
		position: absolute;
		width: 520px;
		height: 520px;
		right: -160px;
		top: -200px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.06);
		pointer-events: none;
	}

	.lb-text {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
	}

	.lb-tag {
		padding: 5px 16px;
		border-radius: 999px;
		background: var(--acc);
		color: var(--c2);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.lb-title {
		margin: 0;
		font-size: clamp(1.5rem, 3.6vw, 2.4rem);
		font-weight: 800;
		line-height: 1.3;
		color: #fff;
	}

	.lb-title span {
		display: block;
	}

	.lb-sub {
		margin: 0;
		padding-left: 14px;
		border-left: 4px solid var(--acc);
		font-size: 1rem;
		opacity: 0.92;
	}

	.lb-icon {
		position: relative;
		z-index: 1;
		flex-shrink: 0;
		width: clamp(110px, 18vw, 180px);
		height: auto;
	}

	@media (max-width: 600px) {
		.lb-icon {
			width: 84px;
			align-self: flex-start;
		}
	}

	.level-head {
		margin-bottom: 18px;
	}

	.eyebrow {
		font-weight: 600;
		color: var(--color-muted);
	}

	.level-head .section-title {
		margin-top: 2px;
	}

	.desc {
		margin: 0;
		color: var(--color-muted);
	}

	.level-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 22px;
	}

	.level-tabs a {
		padding: 8px 18px;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-muted);
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
		transition: background 0.15s, color 0.15s;
	}

	.level-tabs a:hover {
		color: var(--color-primary);
	}

	.level-tabs a.active {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
	}

	.year-tabs {
		display: flex;
		gap: 4px;
		margin-bottom: 18px;
		border-bottom: 2px solid var(--color-border);
	}

	.year-tabs button {
		margin-bottom: -2px;
		padding: 10px 20px;
		border: 0;
		border-bottom: 3px solid transparent;
		background: none;
		font: inherit;
		font-weight: 700;
		color: var(--color-muted);
		cursor: pointer;
	}

	.year-tabs button:hover {
		color: var(--color-primary);
	}

	.year-tabs button.active {
		border-bottom-color: var(--color-primary);
		color: var(--color-primary);
	}

	.level-tabs small {
		font-weight: 400;
		opacity: 0.8;
	}
</style>
