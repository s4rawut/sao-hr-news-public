---
import { byPostDate } from "../../utils/post-date";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "../../lib/cms";
import PostList from "../../components/PostList.astro";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

// sorted by the "วันที่" typed in admin (newest first), so all posts are loaded and paged here
const { entries: allPosts, cacheHint } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 1000,
});
// paging and the ข้าราชการ / ลูกจ้าง switch are done in the browser by PostList
const posts = byPostDate(allPosts);
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={term.label} description={term.label}>
	<Breadcrumbs items={[{ label: "คลังข้อมูล", href: "/posts" }, { label: `#${term.label}` }]} />
	<PostList
		heading={term.label}
		posts={posts}
		basePath={`/tag/${term.slug}`}
	/>
</Base>
