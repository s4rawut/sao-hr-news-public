---
import { getSiteInfo } from "../utils/site-info";

/**
 * Banner at the top of the About page (the page with "แสดงแท็บหน้าเกี่ยวกับเรา").
 * Tag = page title, heading = site name.
 */
interface Props {
	title: string;
}
const { title } = Astro.props;
const info = await getSiteInfo();
const name = info.site_name || "สำนักบริหารทรัพยากรบุคคล";
---

<header class="ab">
	<div class="ab-text">
		<span class="ab-tag">{title}</span>
		<h1 class="ab-title">{name}</h1>
		<p class="ab-sub">สำนักงานการตรวจเงินแผ่นดิน</p>
		<p class="ab-lead">ดูแลงานบริหารทรัพยากรบุคคลของ สตง. ตั้งแต่การสรรหา พัฒนา จนถึงการดูแลบุคลากรทุกคน</p>
	</div>

	<svg class="ab-art" viewBox="0 0 320 240" aria-hidden="true">
		<circle cx="170" cy="118" r="112" fill="#fff" opacity=".08" />
		<circle cx="170" cy="118" r="86" fill="#fff" opacity=".1" />
		<!-- building -->
		<g>
			<path d="M170 28 L262 78 H78 Z" fill="#ffd166" />
			<path d="M170 44 L232 74 H108 Z" fill="#fff" opacity=".35" />
			<rect x="86" y="78" width="168" height="12" rx="3" fill="#fff" />
			<g fill="#fff">
				<rect x="98" y="94" width="14" height="74" rx="3" />
				<rect x="128" y="94" width="14" height="74" rx="3" />
				<rect x="198" y="94" width="14" height="74" rx="3" />
				<rect x="228" y="94" width="14" height="74" rx="3" />
			</g>
			<rect x="154" y="112" width="32" height="56" rx="16" fill="#ffd166" />
			<rect x="80" y="168" width="180" height="10" rx="3" fill="#fff" />
			<rect x="70" y="178" width="200" height="10" rx="3" fill="#fff" opacity=".75" />
		</g>
		<!-- people -->
		<g>
			<circle cx="44" cy="166" r="13" fill="#ffd166" />
			<path d="M20 214 a24 24 0 0 1 48 0 z" fill="#ffd166" />
			<circle cx="296" cy="166" r="13" fill="#fff" />
			<path d="M272 214 a24 24 0 0 1 48 0 z" fill="#fff" />
			<circle cx="170" cy="200" r="11" fill="#fff" />
			<path d="M150 236 a20 20 0 0 1 40 0 z" fill="#fff" />
		</g>
		<!-- sparkles -->
		<g fill="#ffd166">
			<path d="M58 60 l4 10 10 4 -10 4 -4 10 -4 -10 -10 -4 10 -4z" />
			<path d="M286 96 l3 7 7 3 -7 3 -3 7 -3 -7 -7 -3 7 -3z" opacity=".8" />
			<circle cx="270" cy="40" r="4" opacity=".7" />
			<circle cx="34" cy="116" r="3" opacity=".6" />
		</g>
	</svg>
</header>

<style>
	.ab {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		margin-bottom: 22px;
		padding: 36px clamp(22px, 5vw, 56px);
		border-radius: 22px;
		overflow: hidden;
		color: #fff;
		background:
			radial-gradient(rgba(255, 255, 255, 0.08) 2px, transparent 2px) 0 0 / 26px 26px,
			radial-gradient(circle at 85% 20%, rgba(43, 179, 214, 0.55), transparent 55%),
			linear-gradient(135deg, var(--color-primary), var(--color-footer));
		box-shadow: var(--shadow);
	}

	.ab::after {
		content: "";
		position: absolute;
		width: 560px;
		height: 560px;
		left: -260px;
		bottom: -380px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.05);
		pointer-events: none;
	}

	.ab-text {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		min-width: 0;
	}

	.ab-tag {
		padding: 5px 16px;
		border-radius: 999px;
		background: #ffd166;
		color: #3a2a00;
		font-size: 0.85rem;
		font-weight: 700;
	}

	.ab-title {
		margin: 0;
		font-size: clamp(1.6rem, 3.8vw, 2.5rem);
		font-weight: 800;
		line-height: 1.25;
		color: #fff;
	}

	.ab-sub {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
		opacity: 0.95;
	}

	.ab-lead {
		max-width: 560px;
		margin: 2px 0 0;
		padding-left: 14px;
		border-left: 4px solid #ffd166;
		font-size: 0.95rem;
		line-height: 1.6;
		opacity: 0.9;
	}

	.ab-art {
		position: relative;
		z-index: 1;
		flex-shrink: 0;
		width: clamp(180px, 26vw, 300px);
		height: auto;
	}

	@media (max-width: 700px) {
		.ab {
			flex-direction: column-reverse;
			align-items: flex-start;
			padding: 26px 20px;
		}

		.ab-art {
			width: 150px;
			align-self: center;
		}
	}
</style>

