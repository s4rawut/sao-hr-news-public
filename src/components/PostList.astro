---
import { postDate, showNewBadge } from "../utils/post-date";
import { getTaxonomyTermsWithCacheHint, getTermsForEntries, type ContentEntry } from "emdash";
import { getSiteInfo } from "../utils/site-info";
import { formatThaiShort } from "../utils/thai-date";

/**
 * List of คลังข้อมูล posts (newest "วันที่" first — pass them already sorted).
 * All posts are rendered, for ข้าราชการ and ลูกจ้าง together (no group switch here — that is only on
 * the homepage box). A post ticked for one group gets a small chip with the group's name; a post with
 * no กลุ่มผู้ใช้ ticked is for everyone and gets none. The pages (PAGE_SIZE each) work in the browser,
 * so they also work on the static preview/HTML copy.
 */
interface Props {
	heading: string;
	posts: ContentEntry<any>[];
	/** Show each post's category as a chip (on the all-categories list) */
	showCategory?: boolean;
	/** kept for older callers; paging is done in the browser now */
	basePath?: string;
	cursor?: string;
	nextCursor?: string;
}

const PAGE_SIZE = 20;
const { heading, posts, showCategory } = Astro.props;
const ids = posts.map((p) => p.data.id as string);
const [categories, audienceByEntry, audienceTerms] = await Promise.all([
	showCategory ? getTermsForEntries("posts", ids, "category") : Promise.resolve(undefined),
	getTermsForEntries("posts", ids, "post_audience"),
	getTaxonomyTermsWithCacheHint("post_audience"),
]);
if (Astro.cache?.enabled) Astro.cache.set(audienceTerms.cacheHint);
// a group chip only when the post is for some groups, not all of them
const allGroups = audienceTerms.data.length;
const groupsOf = (id: string) => {
	const terms = audienceByEntry.get(id) ?? [];
	return terms.length > 0 && terms.length < allGroups ? terms : [];
};
const now = Date.now();
const { new_badge_days } = await getSiteInfo();
---

<div class="pl-head">
	<h1 class="section-title">{heading}</h1>
</div>
<slot />
<div class="card" data-pl data-page-size={PAGE_SIZE}>
	{
		posts.length === 0 ? (
			<p style="margin:0;padding:24px;text-align:center;color:var(--color-muted)">ยังไม่มีรายการ</p>
		) : (
			<>
				<ul class="item-list">
					{posts.map((post, i) => (
						<li hidden={i >= PAGE_SIZE}>
							<a href={`/posts/${post.id}`}>
								<span>
									<span class="item-meta">
										{categories?.get(post.data.id)?.map((t) => <span class="chip">{t.label}</span>)}
										{groupsOf(post.data.id).map((t) => <span class="chip chip-group">{t.label}</span>)}
										{postDate(post) && (
											<time datetime={postDate(post)!.toISOString()}>{formatThaiShort(postDate(post)!)}</time>
										)}
									</span>
									<span class="item-title" {...post.edit.title}>{post.data.title}</span>
								</span>
								{showNewBadge(post, new_badge_days, now) && <span class="badge-new">ใหม่</span>}
							</a>
						</li>
					))}
				</ul>
			</>
		)
	}
</div>
<nav class="pager pl-pager" aria-label="เปลี่ยนหน้า" data-pl-pager hidden>
	<button type="button" class="button" data-pl-step="-1">‹ หน้าก่อน</button>
	<span class="pl-info" data-pl-info></span>
	<button type="button" class="button" data-pl-step="1">หน้าถัดไป ›</button>
</nav>

<script>
	const box = document.querySelector<HTMLElement>("[data-pl]");
	if (box) {
		const size = Number(box.dataset.pageSize) || 20;
		const items = [...box.querySelectorAll<HTMLLIElement>(".item-list > li")];
		const pager = document.querySelector<HTMLElement>("[data-pl-pager]");
		const info = document.querySelector<HTMLElement>("[data-pl-info]");
		const steps = [...document.querySelectorAll<HTMLButtonElement>("[data-pl-step]")];
		let page = 0;
		const render = () => {
			const list = items;
			const pages = Math.max(1, Math.ceil(list.length / size));
			page = Math.min(Math.max(0, page), pages - 1);
			items.forEach((li) => (li.hidden = true));
			list.slice(page * size, page * size + size).forEach((li) => (li.hidden = false));
			if (pager) pager.hidden = pages <= 1;
			if (info) info.textContent = `หน้า ${page + 1} / ${pages}`;
			if (steps[0]) steps[0].disabled = page === 0;
			if (steps[1]) steps[1].disabled = page >= pages - 1;
		};
		steps.forEach((s) =>
			s.addEventListener("click", () => {
				page += Number(s.dataset.plStep);
				render();
				box.scrollIntoView({ behavior: "smooth", block: "start" });
			}),
		);
		render();
	}
</script>

<style>
	.pl-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 16px;
		margin-bottom: 14px;
	}

	.pl-head .section-title {
		margin: 0;
	}

	.chip-group {
		background: #fff4e5;
		color: #9a5b00;
	}

	.pl-pager {
		align-items: center;
	}

	.pl-pager[hidden] {
		display: none;
	}

	.pl-pager button:disabled {
		opacity: 0.4;
		cursor: default;
	}

	.pl-info {
		font-size: 0.9rem;
		color: var(--color-muted);
	}
</style>
