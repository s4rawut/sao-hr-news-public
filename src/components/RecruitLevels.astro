---
import { postDate } from "../utils/post-date";
import type { getRecruitData } from "../utils/recruit";
import RecruitStatus from "./RecruitStatus.astro";

/**
 * Compact cards, one per position level, grouped under their position type, with a type switch (ทั้งหมด / บริหาร / อำนวยการ …).
 * The switch filters in the browser so it works inside the homepage tab without reloading.
 */
interface Props {
	types: Awaited<ReturnType<typeof getRecruitData>>["types"];
	stageOf: Awaited<ReturnType<typeof getRecruitData>>["stageOf"];
}
const { types, stageOf } = Astro.props;
const levels = types.flatMap((t) => t.levels);
// Inside each type box: levels with announcements come before empty ones; among them the newest
// "วันที่ประกาศ" (any of their announcements) first. Equal or missing dates keep the order set in
// admin → ประเภท / ระดับตำแหน่ง (e.g. บริหาร: ระดับต้น, ระดับสูง; วิชาการ: ปฏิบัติการ … ทรงคุณวุฒิ).
// status rank of a level's latest announcement (1 = เปิดรับสมัคร) — used for the green "open" card
const stageRank = (l: (typeof levels)[number]) => {
	const latest = l.entries[0];
	return latest ? (stageOf(latest.data.id)?.order ?? 998) : 1000;
};
const newest = (l: (typeof levels)[number]) =>
	Math.max(-Infinity, ...l.entries.map((e) => postDate(e)?.getTime() ?? -Infinity));
// groups: 0 = has a dated announcement (newest first), 1 = has announcements without a date,
// 2 = no announcement yet; inside a group (and on equal dates) the admin order is kept
const byStatus = (list: typeof levels) =>
	list
		.map((l, i) => {
			const t = newest(l);
			return { l, i, t, g: t > -Infinity ? 0 : l.entries.length > 0 ? 1 : 2 };
		})
		.sort((a, b) => a.g - b.g || (a.g === 0 && b.t !== a.t ? b.t - a.t : a.i - b.i))
		.map((x) => x.l);
---

{
	levels.length === 0 ? (
		<div class="card rl-empty">ยังไม่มีประเภทตำแหน่ง</div>
	) : (
		<div class="rl" data-recruit-levels>
			<nav class="rl-switch" aria-label="ประเภทตำแหน่ง">
				<button type="button" class="button active is-active" data-type="" aria-pressed="true">
					ทั้งหมด
				</button>
				{types
					.filter((t) => t.levels.length > 0)
					.map((t) => (
						<button type="button" class="button" data-type={t.slug} aria-pressed="false">
							{t.label}
						</button>
					))}
			</nav>

			<div class="rl-groups">
				{types
					.filter((t) => t.levels.length > 0)
					.map((t) => (
						<section class="rl-group" data-type={t.slug}>
							<h3 class="rl-group-title">
								ตำแหน่งประเภท{t.label}
								{(() => {
									const open = t.levels.filter((l) => l.entries[0] && stageOf(l.entries[0].data.id)?.order === 1).length;
									return open > 0 && <span class="rl-open">เปิดรับสมัคร {open} ระดับ</span>;
								})()}
							</h3>
							<div class="rl-grid">
								{byStatus(t.levels).map((l) => {
									const latest = l.entries[0];
									return (
										<a href={`/recruitments/${encodeURIComponent(l.slug)}`} class:list={["rl-card", { "is-open": stageRank(l) === 1 }]}>
											<span class="rl-name">{l.label}</span>
											<span class="rl-meta">
												{latest ? (
													<>
														<RecruitStatus stage={stageOf(latest.data.id)} small />
														{stageOf(latest.data.id)?.period && (
															<span class="rl-period">{stageOf(latest.data.id)!.periodLabel ?? "รับสมัคร"} {stageOf(latest.data.id)!.period}</span>
														)}
													</>
												) : (
													<span class="rl-count">ยังไม่มีประกาศ</span>
												)}
											</span>
										</a>
									);
								})}
							</div>
						</section>
					))}
			</div>
		</div>
	)
}

<script>
	document.querySelectorAll<HTMLElement>("[data-recruit-levels]").forEach((root) => {
		const buttons = root.querySelectorAll<HTMLButtonElement>(".rl-switch button");
		const groups = root.querySelectorAll<HTMLElement>(".rl-group");
		const box = root.querySelector<HTMLElement>(".rl-groups");
		buttons.forEach((b) =>
			b.addEventListener("click", () => {
				const type = b.dataset.type;
				buttons.forEach((x) => {
					x.classList.toggle("active", x === b);
					x.classList.toggle("is-active", x === b);
					x.setAttribute("aria-pressed", String(x === b));
				});
				groups.forEach((g) => (g.hidden = !!type && g.dataset.type !== type));
				box?.classList.toggle("is-filtered", !!type);
			}),
		);
	});
</script>

<style>
	/* small pill chips, same as the document category filter on the homepage */
	.rl-switch {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 16px;
	}

	.rl-switch .button {
		padding: 5px 14px;
		font-size: 0.8rem;
	}

	/* บริหาร (left) and อำนวยการ (right) share a row; every other type takes the full width.
	   Uses the type slugs from admin → ประเภท / ระดับตำแหน่ง (executive, director, academic). */
	.rl-groups {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.rl-group {
		grid-column: 1 / -1;
	}

	.rl-group[data-type="executive"],
	.rl-group[data-type="director"] {
		grid-column: auto;
	}

	/* one type picked in the switch: it gets the full width */
	.rl-groups.is-filtered .rl-group {
		grid-column: 1 / -1;
	}

	/* วิชาการ: its five levels in one row */
	.rl-group[data-type="academic"] .rl-grid {
		grid-template-columns: repeat(5, minmax(0, 1fr));
	}

	@media (max-width: 1000px) {
		.rl-group[data-type="academic"] .rl-grid {
			grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
		}
	}

	@media (max-width: 760px) {
		.rl-groups {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* each position type is its own box */
	.rl-group {
		padding: 18px 20px 20px;
		background: var(--type-tint, var(--color-surface));
		border: 1px solid var(--type-line, var(--color-border));
		border-top: 4px solid var(--type-main, var(--color-border));
		border-radius: 18px;
		box-shadow: var(--shadow);
	}

	/* colour per position type (slugs from admin → ประเภท / ระดับตำแหน่ง); the level pages use the same */
	.rl-group[data-type="executive"] {
		/* ฟ้า */
		--type-main: #0ea5e9;
		--type-dark: #0369a1;
		--type-tint: #f0f9ff;
		--type-line: #bae6fd;
	}

	.rl-group[data-type="director"] {
		/* ทอง */
		--type-main: #c9a227;
		--type-dark: #8a6a00;
		--type-tint: #fdf8e7;
		--type-line: #efdc9b;
	}

	.rl-group[data-type="academic"] {
		/* น้ำเงิน */
		--type-main: #1e40af;
		--type-dark: #1e3a8a;
		--type-tint: #eef2ff;
		--type-line: #c7d2fe;
	}

	.rl-group[data-type="general"] {
		/* ม่วง */
		--type-main: #7c3aed;
		--type-dark: #5b21b6;
		--type-tint: #f5f3ff;
		--type-line: #ddd6fe;
	}

	.rl-open {
		margin-left: auto;
		padding: 3px 12px;
		border-radius: 999px;
		background: #e3f5ea;
		color: #13804a;
		font-size: 0.78rem;
		font-weight: 700;
	}

	.rl-card.is-open {
		border-color: #13804a;
		background: linear-gradient(180deg, #f1faf4, var(--color-surface));
	}

	.rl-group[hidden] {
		display: none;
	}

	.rl-group-title {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 14px;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--type-dark, var(--color-primary-dark));
	}

	.rl-group-title::before {
		content: "";
		width: 4px;
		height: 1.1em;
		border-radius: 2px;
		background: var(--type-main, var(--color-accent));
	}

	.rl-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
		gap: 12px;
	}

	.rl-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
		padding: 14px 18px;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 14px;
		color: inherit;
		text-decoration: none;
		transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
	}

	.rl-card {
		border-color: var(--type-line, var(--color-border));
	}

	.rl-card:hover {
		transform: translateY(-2px);
		border-color: var(--type-main, var(--color-accent));
		box-shadow: var(--shadow);
	}

	.rl-name {
		font-size: 1.02rem;
		font-weight: 700;
		line-height: 1.35;
		color: var(--type-dark, var(--color-primary-dark));
	}

	.rl-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		min-height: 22px;
	}

	.rl-period {
		flex-basis: 100%;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-primary-dark);
	}

	.rl-count {
		font-size: 0.78rem;
		color: var(--color-muted);
	}

	.rl-empty {
		padding: 32px;
		text-align: center;
		color: var(--color-muted);
	}

	@media (max-width: 600px) {
		.rl-grid,
		.rl-group[data-type="academic"] .rl-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 10px;
		}
	}
</style>
