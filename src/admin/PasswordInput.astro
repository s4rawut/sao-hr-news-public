---
/** Password box with a show/hide button, styled like the other inputs. */
interface Props {
	name: string;
	id?: string;
	placeholder?: string;
	autocomplete?: string;
	required?: boolean;
	minlength?: number;
	compact?: boolean;
}
const { name, id, placeholder, autocomplete = "current-password", required, minlength, compact } = Astro.props;
---

<span class:list={["pw-field", { compact }]}>
	<input type="password" name={name} id={id} placeholder={placeholder} autocomplete={autocomplete} required={required} minlength={minlength} />
	<button type="button" class="pw-toggle" aria-label="แสดงรหัสผ่าน" title="แสดง / ซ่อนรหัสผ่าน" data-pw-toggle>
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path class="eye" d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6z"></path>
			<path class="slash" d="M3 3l18 18"></path>
		</svg>
	</button>
</span>

<script>
	document.addEventListener("click", (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-pw-toggle]");
		if (!btn) return;
		const input = btn.parentElement!.querySelector("input")!;
		const show = input.type === "password";
		input.type = show ? "text" : "password";
		btn.classList.toggle("on", show);
		btn.setAttribute("aria-label", show ? "ซ่อนรหัสผ่าน" : "แสดงรหัสผ่าน");
	});
</script>
