{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "HR SAO page embeds",
		"description": "Embed fields for pages",
		"author": "HR SAO"
	},
	"collections": [
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "hide_from_menu",
					"label": "ซ่อนจากเมนูหลัก",
					"type": "boolean"
				},
				{
					"slug": "show_about_tabs",
					"label": "แสดงแท็บ \"เกี่ยวกับเรา\" (ทำเนียบ / ผังที่นั่ง / โครงสร้าง / บุคลากร) ในหน้านี้",
					"type": "boolean"
				},
				{
					"slug": "show_auditee_finder",
					"label": "แสดงคำสั่งมอบหมายและค้นหาหน่วยรับตรวจในหน้านี้",
					"type": "boolean"
				},
				{
					"slug": "show_structure_tabs",
					"label": "แสดงแท็บโครงสร้าง สตง. (ส่วนราชการ / ผัง / แผนที่ภาค) ในหน้านี้",
					"type": "boolean"
				},
				{
					"slug": "embed_url",
					"label": "ฝังรายงาน/แดชบอร์ด: ลิงก์ embed (เช่น Looker Studio, Power BI, Google Sheets)",
					"type": "url"
				},
				{
					"slug": "embed_height",
					"label": "ฝังรายงาน: ความสูง (พิกเซล, ค่าเริ่มต้น 1020)",
					"type": "integer"
				},
				{
					"slug": "embed_link_text",
					"label": "ฝังรายงาน: ข้อความลิงก์ใต้รายงาน",
					"type": "string"
				},
				{
					"slug": "embed_link_url",
					"label": "ฝังรายงาน: ลิงก์เปิดรายงานแบบเต็มหน้า",
					"type": "url"
				},
				{
					"slug": "embed_show_reset",
					"label": "ฝังรายงาน: แสดงปุ่ม Reset ตัวกรอง",
					"type": "boolean"
				},
				{
					"slug": "embed2_url",
					"label": "รายงาน/แดชบอร์ดที่ 2: ลิงก์ (https://… หรือไฟล์ในเว็บ เช่น /dashboards/dpis6-attendance.html)",
					"type": "string"
				},
				{
					"slug": "embed2_height",
					"label": "รายงานที่ 2: ความสูง (px, เว้นว่าง = 1400)",
					"type": "integer"
				},
				{
					"slug": "embed2_title",
					"label": "รายงานที่ 2: ชื่อ (ใช้อ่านออกเสียง/ลิงก์เปิดเต็มจอ)",
					"type": "string"
				}
			]
		}
	]
}